# pipeOS model card — box3
#
# One declarative file per machine. Everything derivable from it is generated
# by `pipebox-card generate`; nothing about this box should be typed onto the
# box by hand. See docs/model-cards.md.
#
# This is the #650 pilot card. Under #651 the same file is served by the boot
# server keyed on MAC, and provisioning a machine is: set BIOS to PXE, drop
# this file on the server, paste two secrets.

NICK=box3
ROLE=BUILD
OWNER_NICK=sam
FOREMAN_NICK=shrek
COHORT_ID=3
GH_OWNER=securedataresearch

# Netboot key under #651. Ignored by the media path; harmless to set early.
MAC=
