# pipeOS model card — box3
#
# One declarative file per machine; everything derivable is generated by
# `pipebox-card generate`. See docs/model-cards.md. Role set per the
# fleet design of 2026-08-09: BUILD, TEST x2, SHIP — verification is the
# scarce resource, so TEST is the doubled role.

NICK=box3
ROLE=BUILD
OWNER_NICK=sam
FOREMAN_NICK=shrek
COHORT_ID=3
GH_OWNER=securedataresearch

# Netboot key under #651 (machine MAC as surveyed 2026-08-09). Ignored by
# the media path; identity rides the stick until netboot lands.
MAC=8c:16:45:fa:84:33

# pipeOS#41: TEST's 25G /work — less than half of box1's 53G, so the same
# percentage leaves much less absolute headroom. Measured 2026-08-10: this box
# reached 57% (12G) from target/ alone before the Foreman took relief. WARN 65
# / CRIT 80 warns and crits earlier than BUILD's 70/85 so there is still real
# free space (~8.75G / ~5G) left to act on at each threshold on this smaller disk.
DISK_WARN_PCT=65
DISK_CRIT_PCT=80

# pipe#650 items 7-8. TOOLCHAIN is what this box must be able to BUILD --
# selfcheck compiles a real artifact per entry, not a version string.
# REPOS is what it must have on disk, with the right origin.
TOOLCHAIN=cargo,rustc
REPOS=pipe,pipeOS

# pipe#650 item 9. What this box may do over pipe WITHOUT asking, as an agent
# labelled `pipebox` -- the label pipebox-listener:12 and
# pipebox-cohort-watch:22 both export. The generator refuses any entry outside
# its own ceiling, so this list chooses within a bound it cannot raise.
#
# THIS IS pipe's BUILT-IN AGENT DEFAULT PLUS send.bbs, AND NOTHING ELSE.
# PolicySet::default grants read, send.dm, send.room, send.lobby, claim. Stated
# as an equation rather than a description because the first draft of this line
# said "one entry differs" while silently dropping send.room and send.lobby --
# and dropping a capability HERE is invisible: decide() denies anything no list
# names, so an omitted capability is refused exactly as hard as a denied one
# while appearing in neither list. Generating from that card would have removed
# two capabilities from four boxes under a change described as adding one.
# (box3, reviewing #58.)
#
# send.bbs is the addition. PolicySet::default denies it as the
# permanent-and-public send, which is right for a general agent and wrong for
# this fleet: we coordinate on the cohort board, so a box that cannot post
# cannot work.
#
# Note which room capability is NOT here: room.accept, JOINING a room, stays
# confirm-gated in the template exactly as the mandate requires. send.room and
# send.lobby are SPEAKING in one already joined -- a different act, permitted
# by the mandate and by pipebox-settings.json's own `pipe room`/`pipe lobby`
# allow entries. Dropping them would have left the two fences disagreeing.
PIPE_CAPS=read,send.dm,send.room,send.lobby,send.bbs,claim

# pipeOS#41 (Foreman ruling 2026-08-10): TEST's 25G /work, same size as box0
# but measured with much lower churn — 3.8G/25G (17%) with 2.5G in target/.
# Same disk, slower accumulation, so an interval between box0's 6h and
# box1's 24h rather than sharing either.
GC_INTERVAL_HOURS=12
