# Maintainer: Sam Reeves <samtreeves@gmail.com>
# Google Antigravity CLI, repackaged from the vendor's glibc build.
#
# WHY THIS IS NOT SHAPED LIKE claude-code: that package runs the official
# install.sh inside the chroot so the installer picks the musl artifact. The
# Antigravity installer has the same musl branch — it correctly detects
# linux_amd64_musl on Alpine — but the musl manifest 404s, so the install ends
# at "Could not connect to the release server". Only linux_amd64 is published,
# and that binary is `interpreter /lib64/ld-linux-x86-64.so.2`. gcompat does not
# rescue it either (measured: __open/__lseek/__read symbol not found).
#
# So this ships the stock glibc binary and runs it under the private sysroot in
# pipeos-glibc. When upstream publishes linux_amd64_musl, this package and
# pipeos-glibc both collapse back into the claude-code shape and the sysroot
# should be deleted rather than kept "just in case".
#
# Staged and sha512-verified against the vendor manifest by
# scripts/30-build-apks.sh, which also rewrites pkgver below — same as
# claude-code's.
pkgname=antigravity-cli
pkgver=0.0.0
pkgrel=0
pkgdesc="Google Antigravity CLI (vendor glibc build, run under pipeos-glibc)"
url="https://antigravity.google/product/antigravity-cli"
arch="x86_64"
license="proprietary"
depends="pipeos-glibc ca-certificates"
options="!check !strip !tracedeps"
source=""

package() {
	install -Dm755 /pipeOS/out/antigravity-stage/antigravity \
		"$pkgdir"/usr/lib/antigravity/antigravity

	# --library-path, NOT an exported LD_LIBRARY_PATH, and the difference is
	# load-bearing: this CLI spawns shell tools, and an exported path would
	# follow every musl child process it runs for the life of the session.
	# Passing it to the loader confines it to this one binary.
	install -Dm755 /dev/stdin "$pkgdir"/usr/bin/agy <<-'EOF'
		#!/bin/sh
		# Antigravity ships no musl build; run the glibc binary under the
		# private sysroot from pipeos-glibc. See that package for why.

		# `agy update` overwrites /usr/lib/antigravity/antigravity in place,
		# which is wrong twice on this image. The root fs is tmpfs, so the new
		# binary is gone at the next boot and the box silently reverts to the
		# packaged version — an update that reports success and does not last.
		# And it would install a binary outside the sha512 the apk was built
		# against, on a stick whose whole point is that its contents are known.
		# Refusing beats surprising; updates land by rebuilding the package.
		#
		# This blocks the EXPLICIT subcommand only. The CLI also checks for
		# updates on its own (it writes ~/.gemini/antigravity-cli/updater and
		# last_check.timestamp); no documented setting to disable that was
		# found, and tmpfs is what bounds it. Revisit if upstream documents one.
		if [ "$1" = update ]; then
		    echo "agy: self-update is disabled on pipeOS — the root fs is tmpfs, so it would not survive a reboot." >&2
		    echo "     Update by rebuilding: WITH_ANTIGRAVITY=1 make apks, then redeploy the image." >&2
		    exit 1
		fi

		G=/usr/glibc-compat
		exec "$G/lib/ld-linux-x86-64.so.2" --library-path "$G/lib" \
		     /usr/lib/antigravity/antigravity "$@"
	EOF
}
