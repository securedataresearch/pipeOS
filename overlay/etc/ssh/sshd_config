# pipeOS: headless box — key-only ssh. The generic client image ships root
# LOCKED (no password exists to guess); operator access is a baked AUTH_KEYS
# public key (make stick AUTH_KEYS=...). Customers never ssh: first contact
# and management is the LAN web wizard (pipeos-web, http://<nick>.local).
PermitRootLogin prohibit-password
PasswordAuthentication no
AuthorizedKeysFile .ssh/authorized_keys
Subsystem sftp internal-sftp

# LAN posture (2026-10-13): IPv4 only (IPv6 is off box-wide), no forwarding
# through the box, few guesses per connection
AddressFamily inet
ListenAddress 0.0.0.0
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 30
