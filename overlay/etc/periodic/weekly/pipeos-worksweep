#!/bin/sh
# pipeos-worksweep — bounded weekly reclaim of /work (pipeOS#90 item 3).
#
# Sam's rule, and the whole design in one line: a full stick is a human visit,
# a rebuilt artifact cache is minutes. So this deletes build output, and
# nothing else, ever.
#
# BOUNDED, NOT CLEVER. This script works from an ALLOWLIST of shapes it is
# allowed to consider, not a denylist of things to avoid. That inversion is
# deliberate: with a denylist, every path nobody thought of is a candidate for
# deletion, and the failure mode of "forgot to exclude it" is unbounded. Here
# the failure mode of forgetting something is that it simply never gets swept,
# which costs disk and no work. `protected` below is a SECOND gate, not the
# first — if a candidate ever matches it, that is a bug in the allowlist and
# this script refuses to delete rather than resolving the disagreement itself.
#
# NO TIER DELETES SOURCE. Every candidate shape below is build output or a
# cache: a `target/` dir, the media `out/` tree, the shared artifact cache. An
# earlier draft had a tier that deleted whole scratch checkouts under
# /work/repos aged by directory mtime; box1 measured it on a live box and it
# selected two real clones and six git worktrees, so it is gone rather than
# fenced (pipeOS#103 review). If reclaiming build output is ever not enough,
# the replacement is an opt-in list of declared scratch SHAPES, not "any
# directory name I do not recognise".
#
# Not swept, by construction (none of these are candidate shapes):
#   /work/claude       agent transcripts and file memory — /root/.claude/
#                      projects is a symlink onto it. Losing it is not a
#                      stalled build, it is the box losing its ability to
#                      report the problem. Not in the issue's list; added
#                      here on purpose and disclosed in the PR.
#   /work/backup       weekly apkovl copies AND the pipe identity/credentials
#                      written by pipeos-backup. Irreplaceable.
#   /work/buildroot    toolchain
#   /work/cargo-home   where pipeOS#90 item 1 puts the shared registry cache.
#                      box2 is right that nothing creates it today — no box
#                      sets CARGO_HOME, so the cache is still at ~/.cargo,
#                      outside /work and therefore outside the allowlist
#                      entirely. This line is pre-emptive, not load-bearing:
#                      it costs nothing now and is already correct on the day
#                      item 1 lands.
#   /work/keys         the fleet signing key's durable home (pipeOS#90/#92)
#   /work/pipebox      this box's own working state
#   every checkout's SOURCE, canonical or scratch, apart from build output
#
# Usage: pipeos-worksweep [--dry-run] [--force]
#   --dry-run  print what would be reclaimed, delete nothing, exit 0
#   --force    sweep even if /work is under the threshold (for the probe)
set -u

mountpoint -q /work || exit 0

dry=0
force=0
for a in "$@"; do
    case "$a" in
        --dry-run) dry=1 ;;
        --force)   force=1 ;;
        *) echo "pipeos-worksweep: unknown argument: $a" >&2; exit 2 ;;
    esac
done

# Threshold is conf-declared for the same reason the selfcheck's is (pipeOS#41):
# a 53G box and a 25G box at the same percentage have very different headroom.
# 60 is below the selfcheck's 70% WARN on purpose — the sweep should be what
# keeps the box off the warning, not a thing that runs after someone is already
# being paged.
_ws_conf=/etc/pipeos/pipebox.conf
[ -r "$_ws_conf" ] && . "$_ws_conf" 2>/dev/null
sweep_pct=${WORKSWEEP_PCT:-60}
# A NON-NUMERIC THRESHOLD FAILS **OPEN**, AND THAT IS WHY THIS ARM EXISTS.
# `:-` covers empty and nothing else. Found by box0 on #103, measured: with
# WORKSWEEP_PCT=sixty, `[ "${use:-0}" -lt "$sweep_pct" ]` exits 2, the `&&`
# chain reads that as "not under threshold", the early exit is skipped, and
# `done_enough` then errors identically on every call so the stop-when-recovered
# logic is gone too — all four tiers run on a 12%-full box. `-5` is the same
# outcome by a different road: numerically valid, semantically "never under".
# There is no `set -e` here, so nothing else catches it.
#
# This is #106's class arriving through the other door — there a bad card value
# hit an arithmetic error, here it hits a `test` error. Note it is NOT the octal
# hole: `test` parses decimal, so `080` was always read as 80 and behaves. The
# rule is the same anyway, because the two scripts should not disagree about
# what a number is; that disagreement was the whole of #106.
#
# It falls back rather than dying — this is an unattended weekly cron and a bad
# threshold must not become a job that never runs — but it SAYS SO, because a
# silent fallback is how the conf ends up reading one thing while the box does
# another, which is the defect #101 was filed over.
#
# Validated HERE, at the assignment, and not after log() is defined further
# down: this must be true before any code path can read sweep_pct, and a guard
# that sits after its first reader is the ordering defect #101 was filed over.
# It uses the raw value in the message because that is the thing the operator
# typed and the thing they need to see.
_ws_bad_pct=
case "$sweep_pct" in
    ''|*[!0-9]*) _ws_bad_pct=$sweep_pct; sweep_pct=60 ;;
esac

# The canonical clones. They are named only so their `target/` is swept LAST
# among the target/ dirs (tier 2, not tier 1) — a scratch checkout's build
# output is cheaper to lose than the clone everyone works in. This list is not
# used to classify anything as deletable; "not one of these two names" is not
# the predicate "scratch", and nothing here relies on it being one.
CANONICAL="pipe pipeOS"

usage() { df -P /work 2>/dev/null | awk 'NR==2{print $5+0}'; }

log() {
    echo "$*"
    [ -d /work/logs ] && echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >> /work/logs/worksweep.log
}

# Second gate. Anything here must never be deleted, whatever the allowlist
# below decided. A hit means the two disagree, which is a bug, so it refuses.
protected() {
    case "$1" in
        /work|/work/|/|"") return 0 ;;
        /work/claude|/work/claude/*)         return 0 ;;
        /work/backup|/work/backup/*)         return 0 ;;
        /work/buildroot|/work/buildroot/*)   return 0 ;;
        /work/cargo-home|/work/cargo-home/*) return 0 ;;
        /work/keys|/work/keys/*)             return 0 ;;
        /work/pipebox|/work/pipebox/*)       return 0 ;;
        /work/repos/pipeOS/out/keys|/work/repos/pipeOS/out/keys/*) return 0 ;;
        /work/*) return 1 ;;
        *) return 0 ;;   # anything outside /work is not ours to touch
    esac
}

kb() { du -xsk "$1" 2>/dev/null | awk '{print $1+0}'; }

reclaimed=0
refused=0

reclaim() { # reclaim PATH REASON
    p=$1; why=$2
    [ -e "$p" ] || return 0
    # Never follow a symlink out of the workspace: remove the link, not a tree.
    if [ -L "$p" ]; then
        log "  skip (symlink) $p"
        return 0
    fi
    if protected "$p"; then
        log "  REFUSED $p — allowlist and protected list disagree, not deleting"
        refused=$((refused + 1))
        return 0
    fi
    size=$(kb "$p")
    if [ "$dry" = 1 ]; then
        log "  would reclaim ${size}K  $p  ($why)"
    else
        rm -rf -- "$p" || { log "  FAILED to remove $p"; return 0; }
        log "  reclaimed ${size}K  $p  ($why)"
    fi
    reclaimed=$((reclaimed + size))
    return 0
}

# A rejected threshold is said out loud even on a run that then exits quietly
# under the fallback — the whole point is that the conf and the box must not
# disagree in silence.
[ -n "$_ws_bad_pct" ] && \
    log "pipeos-worksweep: WORKSWEEP_PCT is not a plain integer ('$_ws_bad_pct') — using the 60% default"

# Under threshold and not forced? Say nothing and cost nothing. `du` on a
# multi-gigabyte workspace is not free, so a healthy box never pays for it.
use=$(usage)
if [ "$force" = 0 ] && [ "${use:-0}" -lt "$sweep_pct" ]; then
    exit 0
fi
log "pipeos-worksweep: /work ${use:-?}% used (threshold ${sweep_pct}%)$([ "$dry" = 1 ] && echo ' [dry-run]')"

is_canonical() {
    for c in $CANONICAL; do [ "$1" = "$c" ] && return 0; done
    return 1
}

# Stop as soon as we are back under the threshold. Tiers are ordered by what
# the deletion costs the fleet, cheapest first: scratch build output nobody
# will rebuild, then the canonical clones' build output, then the media build
# tree, and only last the shared cache every checkout uses.
done_enough() {
    [ "$force" = 1 ] && return 1        # --force sweeps every tier, for the probe
    [ "$dry" = 1 ] && return 1          # dry-run reports the full plan
    u=$(usage)
    [ "${u:-100}" -lt "$sweep_pct" ]
}

# ---- tier 1: target/ dirs inside scratch checkouts
#
# Read from a temp file, not from a pipe: `find | while read` puts the loop in
# a SUBSHELL, so every `reclaimed` increment inside it is discarded and the
# final total silently reports 0K after deleting gigabytes.
_ws_tmp=$(mktemp) || exit 0
trap 'rm -f "$_ws_tmp"' EXIT INT TERM

for d in /work/repos/*/; do
    done_enough && break
    [ -d "$d" ] || continue
    name=$(basename "$d")
    is_canonical "$name" && continue
    # `${d%/}` — STRIP THE GLOB'S TRAILING SLASH BEFORE `find` SEES IT.
    #
    # This is the only place in the script where a path comes from a glob and
    # goes into `find`, and the slash is load-bearing in the worst direction: a
    # trailing slash is resolved by the KERNEL during path lookup, so `find`
    # descends THROUGH a symlinked checkout. Same mechanism as #100/#105,
    # pointing the other way — there a missing slash made find refuse to follow
    # and the predicate was permanently false.
    #
    # Both guards miss it without this. `[ -d "$d" ]` above is true of a
    # symlink-to-directory, and `reclaim`'s `[ -L "$p" ]` never fires because
    # the candidate find yields is `<link>/target`, a REAL directory behind the
    # link; `protected()` is textual and that path starts with /work/, so it
    # answers "not protected". box2 raised it, box0 reproduced it independently
    # under both GNU and busybox find: a tree outside the workspace deleted, and
    # the log line naming it by the in-workspace path it was reached through, so
    # the audit trail did not reveal it.
    #
    # With the slash stripped, `find` treats the link as a plain file and
    # descends nowhere, so a symlinked checkout is silently skipped. That is the
    # safe answer under this script's own stated policy: forgetting something
    # costs disk and no work. The tier that got this right (`reclaim "${d%/}"`)
    # was the old tier 2, deleted in the previous push — so this now has no
    # sibling in the file to inherit from, which is exactly why it is spelled
    # out here.
    find "${d%/}" -maxdepth 3 -type d -name target -prune 2>/dev/null | sort > "$_ws_tmp"
    while read -r t; do
        [ -n "$t" ] || continue
        done_enough && break
        reclaim "$t" "scratch build output"
    done < "$_ws_tmp"
done

# ---- tier 2: build output in the canonical clones
for c in $CANONICAL; do
    done_enough && break
    reclaim "/work/repos/$c/target" "canonical clone build output"
done

# ---- tier 3: the pipeOS media build tree. box1 classified this on 2026-08-14:
# 7.6G, every byte a build product — images, chroot, ovl, payloads — EXCEPT
# out/keys, which holds the fleet signing key and is protected above. Swept
# entry by entry rather than as a whole so out/keys survives by construction
# and not merely by the guard.
if ! done_enough && [ -d /work/repos/pipeOS/out ]; then
    for e in /work/repos/pipeOS/out/*; do
        done_enough && break
        [ -e "$e" ] || continue
        case "$(basename "$e")" in
            keys) continue ;;
        esac
        reclaim "$e" "media build product"
    done
fi

# ---- tier 4: the shared artifact cache (pipeOS#90 item 1). Last, because
# every checkout on the box shares it — reclaiming it costs one full rebuild
# for all of them rather than one.
done_enough || reclaim /work/cargo-target "shared artifact cache"

use=$(usage)
if [ "$dry" = 1 ]; then
    log "pipeos-worksweep: would reclaim ${reclaimed}K; /work still ${use:-?}%"
else
    log "pipeos-worksweep: reclaimed ${reclaimed}K; /work now ${use:-?}%"
fi
[ "$refused" -gt 0 ] && log "pipeos-worksweep: $refused candidate(s) REFUSED — see pipeOS#90"
exit 0
