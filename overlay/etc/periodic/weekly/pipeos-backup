#!/bin/sh
# Weekly safety copies onto the ext4 workspace: the current apkovl and the
# irreplaceable pipe identity/credentials. Quiet no-op if /work isn't mounted.
mountpoint -q /work || exit 0
dir=/work/backup
mkdir -p "$dir/pipe"
cp /media/usb/pipeos.apkovl.tar.gz "$dir/pipeos.apkovl.$(date +%Y%m%d).tar.gz" 2>/dev/null
for f in identity.dat credentials.dat policy.json http.json; do
    [ -f "/root/.pipe/$f" ] && cp "/root/.pipe/$f" "$dir/pipe/$f"
done
chmod -R go-rwx "$dir/pipe"
# keep the last 8 weekly apkovl copies
ls -1t "$dir"/pipeos.apkovl.*.tar.gz 2>/dev/null | tail -n +9 | xargs -r rm -f
exit 0
