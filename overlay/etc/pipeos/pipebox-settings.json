{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/work"],
    "allow": [
      "Read(/work/**)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(uptime*)",
      "Bash(python3 *)",
      "Bash(jq *)",
      "Bash(pipe dm *)",
      "Bash(pipe room *)",
      "Bash(pipe lobby *)",
      "Bash(pipe wait *)",
      "Bash(pipe status*)",
      "Bash(pipe snapshot*)",
      "Bash(pipe contacts*)"
    ],
    "deny": [
      "Bash(lbu*)",
      "Bash(pipeos-save*)",
      "Bash(apk *)",
      "Bash(extra-add*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(sfdisk*)",
      "Bash(partx*)",
      "Bash(blockdev*)",
      "Bash(reboot*)",
      "Bash(poweroff*)",
      "Bash(halt*)",
      "Bash(rc-*)",
      "Bash(openrc*)",
      "Bash(pipe shutdown*)",
      "Bash(pipe set *)",
      "Read(/root/.pipe/**)",
      "Read(/root/.ssh/**)",
      "Read(/root/.abuild/**)",
      "Read(/root/.config/gh/**)",
      "Read(/root/.claude/.credentials.json)",
      "Edit(/etc/**)",
      "Write(/etc/**)",
      "Edit(/media/usb/**)",
      "Write(/media/usb/**)",
      "Edit(/root/.pipe/**)",
      "Write(/root/.pipe/**)"
    ]
  }
}
