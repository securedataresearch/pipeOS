#!/sbin/openrc-run
description="/data's hot set (logs, roster, ledger, schedule state) staged in RAM; flushed to the stick hourly, at save, at stop"

# After the mount, before anything that writes to /data — every supervised
# service and crond (the tick, the periodic flush) start once the binds are
# up, so no writer ever opens the disk copy. See pipeos-work's header.
depend() {
	need localmount
	after pipeos-workspace
	before pipeos-vault pipeos-web pipeos-mdns pipe-daemon pipebox-listener pipeos-assistant \
	       pipeos-stream pipeos-support pipeos-terminals pipeos-nas crond pipeos-selfcheck
}

start() {
	ebegin "Staging /data's hot set in RAM"
	/usr/local/bin/pipeos-work hot-up
	eend $?
}

stop() {
	ebegin "Flushing /data's hot set to disk"
	/usr/local/bin/pipeos-work hot-down
	eend $?
}
