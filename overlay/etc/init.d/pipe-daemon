#!/sbin/openrc-run
description="pipe P2P daemon for pipebox"

supervisor=supervise-daemon
command=/usr/bin/pipe
command_args="run"
respawn_delay=5
respawn_max=0

export HOME=/root
# OpenRC owns restarts; disable pipe's self-re-exec watcher
export PIPE_NO_SELF_RESTART=1

output_log=/work/logs/pipe-daemon.log
error_log=/work/logs/pipe-daemon.log

depend() {
	need net
	use chronyd
	after chronyd local
}

start_pre() {
	# /work is mounted by local.d (00-workspace.start); refuse to run without
	# it rather than silently logging into tmpfs
	if ! mountpoint -q /work; then
		eerror "/work not mounted (LABEL=PIPEWORK missing?)"
		return 1
	fi
	checkpath -d -m 0755 /work/logs || return 1
}
