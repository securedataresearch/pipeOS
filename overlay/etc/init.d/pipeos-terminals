#!/sbin/openrc-run
# pipeos-terminals — per-user browser terminals (ttyd + su -l <user>).
#
# One ttyd instance per terminal-enabled user, each on its own port with its
# own password, each dropping into that user's REAL non-root login shell in
# /work/home/<user> — this is how people use the box without being root.
# Toggled from the web UI (Users page); NOT in the image's default runlevel.
#
# /etc/pipeos/terminals.conf (mode 600 — generated by webd from users.json):
#   TERM_<N>_USER=  unix user
#   TERM_<N>_PORT=  TCP port (7701+)
#   TERM_<N>_PASS=  ttyd basic-auth password (required per slot)
description="per-user browser terminals (ttyd + su)"

supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

output_log=/work/logs/pipeos-terminals.log
error_log=/work/logs/pipeos-terminals.log

CONF=/etc/pipeos/terminals.conf
MAX=16

depend() {
	need net pipeos-workspace
	after chronyd
}

slots() {
	# print "user port pass" per configured slot
	# shellcheck disable=SC1090
	. "$CONF"
	i=1
	while [ "$i" -le "$MAX" ]; do
		eval "u=\${TERM_${i}_USER:-}"
		eval "p=\${TERM_${i}_PORT:-}"
		eval "w=\${TERM_${i}_PASS:-}"
		[ -n "$u" ] && [ -n "$p" ] && [ -n "$w" ] && printf '%s %s %s\n' "$u" "$p" "$w"
		i=$((i + 1))
	done
}

start_pre() {
	if [ ! -r "$CONF" ]; then
		eerror "terminals are enabled but $CONF does not exist — add a user with a terminal in the web UI"
		return 1
	fi
	if [ -z "$(slots)" ]; then
		eerror "terminals are enabled but no user has one configured (name+port+password) — see the web UI"
		return 1
	fi
	command -v ttyd >/dev/null 2>&1 || { eerror "ttyd is not installed on this image"; return 1; }
	checkpath -d -m 0755 /work/logs || return 1
}

start() {
	ebegin "Starting user terminals"
	rc=0
	slots | while read -r u p w; do
		supervise-daemon "pipeos-terminals.$u" --start \
			--stdout "$output_log" --stderr "$error_log" \
			--respawn-delay "$respawn_delay" --respawn-max "$respawn_max" \
			/usr/local/bin/pipeos-term-run "$u" "$p" "$w" || rc=1
	done
	eend $rc
}

stop() {
	ebegin "Stopping user terminals"
	# stop every named instance, including users removed from the conf since
	for pf in /run/supervise-pipeos-terminals.*.pid; do
		[ -e "$pf" ] || continue
		inst=${pf#/run/supervise-}
		inst=${inst%.pid}
		supervise-daemon "$inst" --stop 2>/dev/null
	done
	eend 0
}
