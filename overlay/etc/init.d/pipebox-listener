#!/sbin/openrc-run
description="pipebox inbox listener (pipe wait -> claude -p)"

supervisor=supervise-daemon
command=/usr/local/bin/pipebox-listener
respawn_delay=10
respawn_max=0

export HOME=/root

output_log=/work/logs/pipebox-listener-svc.log
error_log=/work/logs/pipebox-listener-svc.log

depend() {
	need pipe-daemon
	after pipe-daemon
}

start_pre() {
	# wait out the boot-time /work mount race (see pipe-daemon start_pre)
	_i=0
	while ! mountpoint -q /work; do
		_i=$((_i+1))
		if [ "$_i" -ge 30 ]; then
			eerror "/work not mounted after 30s"
			return 1
		fi
		sleep 1
	done
	if [ ! -x /usr/local/bin/pipebox-listener ]; then
		eerror "listener script missing"
		return 1
	fi
	checkpath -d -m 0755 /work/logs /work/pipebox || return 1
}
