#!/sbin/openrc-run
description="pipebox inbox listener (pipe wait -> claude -p)"

supervisor=supervise-daemon
command=/usr/local/bin/pipebox-listener
respawn_delay=10
respawn_max=0

export HOME=/root

output_log=/data/logs/pipebox-listener-svc.log
error_log=/data/logs/pipebox-listener-svc.log

depend() {
	need pipe-daemon
	after pipe-daemon
}

start_pre() {
	# wait out the boot-time /data mount race (see pipe-daemon start_pre)
	_i=0
	# Either name: the volume is mounted at /data and /work is a symlink to
	# it (#330), but a deploy installs this file while the volume is still
	# on /work and the reboot that moves it comes later — so both are asked
	# and the restart in between does not fail on the name.
	while ! mountpoint -q /data && ! mountpoint -q /work; do
		_i=$((_i+1))
		if [ "$_i" -ge 30 ]; then
			eerror "/data not mounted after 30s"
			return 1
		fi
		sleep 1
	done
	if [ ! -x /usr/local/bin/pipebox-listener ]; then
		eerror "listener script missing"
		return 1
	fi
	checkpath -d -m 0755 /data/logs /data/pipebox || return 1
}
