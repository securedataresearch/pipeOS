#!/sbin/openrc-run
# pipeos-stream — the streaming service. Toggled from the web UI; NOT in the
# image's default runlevel. Refuses to start until /etc/pipeos/stream.conf is
# filled in — an enabled-but-unconfigured stream should say so on the dashboard,
# not spin a broken ffmpeg.
#
# Two modes (STREAM_MODE, default "media"):
#   media   — restream an existing A/V feed: ffmpeg -re -i STREAM_SRC ... DST.
#             The original behaviour; unchanged.
#   browser — render a web PAGE (STREAM_URL) to video and push it. A page is not
#             a media feed, so this hands off to /usr/local/bin/pipeos-stream-run
#             (Xvfb + Chromium + ffmpeg, fanned out to one or two RTMP targets).
#
# stream.conf (shell-sourceable, mode 600 — STREAM_KEY* are secrets):
#   STREAM_MODE=          media | browser        (default media)
#   media:   STREAM_SRC=  input url/device       STREAM_ARGS= extra ffmpeg args
#   browser: STREAM_URL=  page to render         STREAM_RES=/STREAM_FPS=/STREAM_VAAPI=
#   both:    STREAM_DST=/STREAM_KEY=             target 1 (e.g. YouTube)
#            STREAM_DST2=/STREAM_KEY2=           target 2, optional (e.g. Twitch)
description="web-render / restream to RTMP (configured in /etc/pipeos/stream.conf)"

supervisor=supervise-daemon
respawn_delay=15
respawn_max=0

output_log=/work/logs/pipeos-stream.log
error_log=/work/logs/pipeos-stream.log

CONF=/etc/pipeos/stream.conf

depend() {
	need net pipeos-workspace
	after chronyd
}

start_pre() {
	if [ ! -r "$CONF" ]; then
		eerror "streaming is enabled but $CONF does not exist yet — configure it in the web UI"
		return 1
	fi
	# shellcheck disable=SC1090
	. "$CONF"
	command -v ffmpeg >/dev/null 2>&1 || { eerror "ffmpeg is not installed on this image"; return 1; }
	checkpath -d -m 0755 /work/logs || return 1

	if [ "${STREAM_MODE:-media}" = browser ]; then
		if [ -z "${STREAM_URL:-}" ] || [ -z "${STREAM_DST:-}" ]; then
			eerror "browser stream not configured (STREAM_URL/STREAM_DST empty in $CONF) — fill it in from the web UI"
			return 1
		fi
		command -v chromium >/dev/null 2>&1 || { eerror "chromium is not installed on this image"; return 1; }
		command -v Xvfb >/dev/null 2>&1 || { eerror "Xvfb is not installed on this image"; return 1; }
	else
		if [ -z "${STREAM_SRC:-}" ] || [ -z "${STREAM_DST:-}" ]; then
			eerror "streaming is not configured (STREAM_SRC/STREAM_DST empty in $CONF) — fill it in from the web UI"
			return 1
		fi
	fi
}

start() {
	# shellcheck disable=SC1090
	. "$CONF"
	if [ "${STREAM_MODE:-media}" = browser ]; then
		ebegin "Starting browser restream ($STREAM_URL)"
		supervise-daemon pipeos-stream --start \
			--stdout "$output_log" --stderr "$error_log" \
			--respawn-delay "$respawn_delay" --respawn-max "$respawn_max" \
			/usr/local/bin/pipeos-stream-run
		eend $?
		return
	fi
	# media mode — unchanged.
	_dst="${STREAM_DST%/}${STREAM_KEY:+/$STREAM_KEY}"
	ebegin "Starting ffmpeg restream"
	# shellcheck disable=SC2086
	supervise-daemon pipeos-stream --start \
		--stdout "$output_log" --stderr "$error_log" \
		--respawn-delay "$respawn_delay" --respawn-max "$respawn_max" \
		/usr/bin/ffmpeg -- -hide_banner -loglevel warning \
		-re -i "$STREAM_SRC" ${STREAM_ARGS:--c copy -f flv} "$_dst"
	eend $?
}
