#!/sbin/openrc-run
# pipeos-signin — consume a one-time pipe key staged at build time
# (`make stick PIPE_KEY=...`), so a box signs itself in on its FIRST boot
# with no console, no keyboard, no display. This is the first-contact half
# of headless administration: after this runs the box is on pipe, the boot
# report DMs the owner, and everything else happens by DM from anywhere —
# no inbound network access to the box is ever needed.
#
# The key is one-time and short-lived (~15 min from minting), so this is a
# oneshot with no retry: whatever the outcome, the key file is consumed.
# A failure is loud (log + console) and the fallback is pipebox-setup —
# the box is then exactly what an unstaged box always was.
description="first-boot pipe sign-in from a staged one-time key"

KEYFILE=/etc/pipeos/pipe-signin.key
LOG=/work/logs/pipeos-signin.log

depend() {
	need pipe-daemon
	after pipe-daemon
}

start() {
	[ -f "$KEYFILE" ] || return 0
	export HOME=/root
	ebegin "pipe sign-in from staged key"

	# The daemon service is up before the socket answers; give it a moment.
	_i=0
	while ! pipe status >/dev/null 2>&1; do
		_i=$((_i+1))
		[ "$_i" -ge 60 ] && break
		sleep 1
	done

	_key=$(cat "$KEYFILE")
	_ok=no
	if [ -n "$_key" ] && pipe "$_key" >>"$LOG" 2>&1; then
		_ok=yes
		# Without remember_login the auth dies with this boot — the exact
		# opposite of what a staged sign-in is for.
		pipe set remember_login on >>"$LOG" 2>&1 || true
		pipe set agent_events on   >>"$LOG" 2>&1 || true
	fi

	# Consumed either way: the key is single-use and expires in minutes, so
	# retrying a failure can only ever fail again, slower.
	rm -f "$KEYFILE"

	if [ "$_ok" = yes ]; then
		_nick=$(pipe status 2>/dev/null | head -1)
		echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) signed in: $_nick" >>"$LOG" 2>&1
		# Persist the sign-in and the consumed key file's removal NOW —
		# an auth that exists only in tmpfs is gone at the next boot.
		pipeos-save >>"$LOG" 2>&1 \
			|| ewarn "signed in but pipeos-save failed — auth is NOT persisted"
		eend 0
	else
		echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) staged key rejected (expired?)" >>"$LOG" 2>&1
		printf 'pipeos: staged pipe sign-in FAILED (key expired?) — run pipebox-setup\n' \
			> /dev/console 2>/dev/null || true
		eend 1 "staged pipe key rejected — sign in via pipebox-setup"
	fi
}
