#!/sbin/openrc-run
# pipeos-mdns — answers <hostname>.local so browsers can find the box.
description="minimal mDNS responder: <hostname>.local, pipeos.local, and the _pipeos._tcp lobby"

supervisor=supervise-daemon
command=/usr/local/bin/pipeos-mdnsd
respawn_delay=5
respawn_max=0
# UDP 5353 needs no privilege; drop root when the build-time account exists
# (fresh images), fall back silently on older media.
if getent passwd svc-mdns >/dev/null 2>&1; then
	command_user="svc-mdns:svc-mdns"
fi

output_log=/work/logs/pipeos-mdns.log
error_log=/work/logs/pipeos-mdns.log

depend() {
	need net
	after hostname pipeos-workspace
}

start_pre() {
	mountpoint -q /work && { checkpath -d -m 0755 /work/logs || return 1; }
	# supervise-daemon opens the log AFTER dropping to command_user, and
	# /work/logs is root's: on the first image with the svc-mdns account
	# (2026-09-09, the first two Machines) the responder never started and
	# nothing said so — the log it would have said it in was the thing it
	# could not open. The file is made here, owned by the user.
	if mountpoint -q /work && [ -n "${command_user:-}" ]; then
		checkpath -f -m 0644 -o "$command_user" /work/logs/pipeos-mdns.log || return 1
	fi
	# the peer cache the lobby reads (checkpath makes no parents)
	checkpath -d -m 0755 /run/pipeos || return 1
	if getent passwd svc-mdns >/dev/null 2>&1; then
		checkpath -d -m 0755 -o svc-mdns:svc-mdns /run/pipeos/mdns || return 1
	else
		checkpath -d -m 0755 /run/pipeos/mdns || return 1
	fi
	# the roster (#241): every Machine ever seen, with its MAC, on /work so a
	# powered-off one still has a row and a Wake button. Owned by the user
	# like the cache; skipped without /work (the responder retries each tick)
	if mountpoint -q /work; then
		if getent passwd svc-mdns >/dev/null 2>&1; then
			checkpath -d -m 0755 -o svc-mdns:svc-mdns /work/pipeos /work/pipeos/mdns || return 1
		else
			checkpath -d -m 0755 /work/pipeos /work/pipeos/mdns || return 1
		fi
	fi
	# no /work is not fatal for discovery — log to nowhere and answer anyway
	if ! mountpoint -q /work; then
		output_log=/dev/null
		error_log=/dev/null
	fi
	return 0
}
