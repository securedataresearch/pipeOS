#!/bin/sh
# Final state save on shutdown/reboot, plus the clean-shutdown breadcrumb
# the boot selfcheck reads to tell an orderly stop from a power cut.
# Safety checks live in pipeos-save.
mkdir -p /work/.pipeos 2>/dev/null && touch /work/.pipeos/clean-shutdown && sync
# a fenced save is the right answer here: this reboot boots what flash apply
# staged, and saving RAM now would overwrite it (pipeOS#276)
[ -f /run/pipeos/flash-pending ] && exit 0
exec /usr/local/bin/pipeos-save
