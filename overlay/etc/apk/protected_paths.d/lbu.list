+usr/local
+root/.claude
+root/.claude.json
+root/.pipe
+root/.hermes/auth.json
+root/.hermes/.env
+root/.hermes/config.yaml
+root/.ssh
# custom init scripts: apk audit skips new files under /etc/init.d (assumes
# package-owned), so without these + lines the runlevel symlinks commit but
# the scripts vanish on reboot — the chronyd dangling-symlink failure again
+etc/init.d/pipeos-workspace
+etc/init.d/pipe-daemon
+etc/init.d/pipebox-listener
+etc/init.d/pipeos-selfcheck
+etc/init.d/pipeos-web
+etc/init.d/pipeos-mdns
+etc/init.d/pipeos-stream
+etc/init.d/pipeos-assistant
+etc/init.d/pipeos-support
# boot reconciler for services.conf — custom /etc/local.d file, same apk-audit
# blind spot as the init scripts above
+etc/local.d/pipeos-services.start
# users: per-user browser terminals + the dashboard's user records + doas policy
+etc/init.d/pipeos-terminals
# network storage (SMB): the service, its declared shares, the replayed
# external mounts, and samba's passdb (private dir) — all custom files in
# apk audit's blind spots
+etc/init.d/pipeos-nas
+etc/local.d/pipeos-mounts.start
+etc/pipeos/nas.conf
+etc/pipeos/mounts.conf
+etc/pipeos/nas-private
+etc/pipeos/users.json
+etc/pipeos/terminals.conf
+etc/doas.d/pipeos.conf
+etc/pipeos/support.conf
+etc/pipeos/support_key
+etc/pipeos/support_key.pub
# web wizard state: the claim credential, the enabled-services record, and the
# streaming config are all custom /etc/pipeos files apk audit would drop
+etc/pipeos/web-admin.conf
+etc/pipeos/services.conf
+etc/pipeos/stream.conf
+etc/pipeos/assistant.conf
# the box's local CA + server cert (HTTPS). The CA is what the owner installs on
# their devices to trust this box, so it MUST persist — regenerating it would
# break every device that trusted the old one. Keys are mode 600.
+etc/pipeos/tls
# the Claude credential the listener/cohort-watch source (pipeOS#49 flagged it
# as shared; here it is at least PERSISTED — before this line nothing kept it)
+etc/pipeos/claude-auth.env
# apk signing key (extra repo index) and gh auth — lose these and you re-key/re-auth
+root/.abuild
+root/.config/gh
# root's git config, which `gh auth setup-git` writes the HTTPS credential
# helper into. It is tmpfs like everything else here, so without this line it
# dies at every reboot and the next `git fetch` on box0/2/3 fails with "could
# not read Username" on a non-interactive tty — a message that never mentions
# credentials. That is what stopped the 2026-08-15 hand deploy on three boxes
# (pipeOS#97 item 4a). The token itself is NOT here: it lives in
# root/.config/gh above, which this list already carries.
+root/.gitconfig
# self-update: the applied-digest stamp lives on /work (ext4), but the config
# and the cron wrapper are custom files under /etc that apk audit would drop
+etc/pipeos/selfupdate.conf
+etc/periodic/daily/pipeos-selfupdate
+etc/periodic/daily/pipeos-checkout-refresh
# same shape, weekly: the reclaim job is a custom file under /etc/periodic, so
# apk audit does not see it and a reboot would take it with everything else
# that was never in a package (pipeOS#90 item 3)
+etc/periodic/weekly/pipeos-worksweep
# repo checkouts live on ext4 (/work/repos); these are just symlinks now
+root/pipeOS
+root/pipe
+root/pipe-claude
-root/.hermes/cache
-root/.hermes/audio_cache
# root/.claude/projects SHOULD be a symlink to /work/claude/projects (ext4), so
# the link itself rides along inside +root/.claude and transcripts never reach
# the apkovl. Do NOT rely on that being true. A box provisioned before the
# migration, or one where /work was created late, still has a real directory
# here — and then the blanket +root/.claude above sweeps every transcript into
# the overlay, on vfat, stored BACKUP_LIMIT+1 times. Observed on .63: the first
# save after this overlay landed put a session transcript in the apkovl.
#
# Three lines below. On a migrated box they reproduce the unpatched apkovl
# byte for byte; on an unmigrated one they correct the layout:
#   the FIRST include keeps the symlink itself in the apkovl — without it the
#     link does not survive a reboot and agent memory becomes unreachable
#   the exclude keeps transcripts out of the apkovl on an unmigrated box
#   the LAST include keeps agent memory in, which must survive either way
#
# ORDER IS LOAD-BEARING, and in BOTH directions, because two different
# consumers read this file with different rules:
#   apk audit --backup honours + and - in FILE ORDER, last match wins. So the
#     memory include must come AFTER the exclude or it is swallowed by it, and
#     the symlink include must come BEFORE the exclude or it would re-include
#     the whole transcript tree on an unmigrated box.
#   lbu's own filelist pass re-adds a + path only when it is a symlink or a
#     plain file (see _gen_filelist in /usr/sbin/lbu) and ignores order
#     entirely. That is what makes the first include self-limiting: it puts
#     the link back on a migrated box and does nothing at all on one where
#     projects is still a real directory.
+root/.claude/projects
-root/.claude/projects
+root/.claude/projects/-root/memory
-root/.claude/shell-snapshots
-root/.claude/statsig
-root/.claude/todos
# apkovl bloat guards: caches and per-session state that regenerate; on vfat
# with BACKUP_LIMIT=3 every byte here is stored 4x
-root/.claude/plugins
-root/.claude/cache
-root/.claude/file-history
-root/.claude/backups
-root/.claude/session-env
-root/.claude/sessions
-root/.claude/tasks
# Headless-browser caches (playwright and kin) can be ~100MB downloads;
# keeping them out of the apkovl means a reboot cannot make one permanent
# on the boot media.
-root/.cache/ms-playwright-go
