{
  "model": "opus",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/work"],
    "allow": [
@@ROLE_ALLOW@@
      "Read(/work/**)",
      "Bash(sh -n *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(uptime*)",
      "Bash(python3 *)",
      "Bash(jq *)",
      "Bash(pipe dm *)",
      "Bash(pipe room *)",
      "Bash(pipe lobby *)",
      "Bash(pipe wait *)",
      "Bash(pipe status*)",
      "Bash(pipe snapshot*)",
      "Bash(pipe contacts*)",
      "Bash(pipe cohorts board*)",
      "Bash(pipe claim*)",
      "Bash(pipe claims*)",
      "Bash(pipe --version)",
      "Bash(pipeos status*)",
      "Bash(pipeos verify*)",
      "Bash(pipeos diff*)",
      "Bash(pipeos snapshot ls*)",
      "Bash(pipebox-card verify*)",
      "Bash(pipebox-card show*)"
    ],
    "deny": [
      "Bash(lbu*)",
      "Bash(pipeos-save*)",
      "Bash(pipeos save*)",
      "Bash(pipeos pkg*)",
      "Bash(pipeos rollback*)",
      "Bash(pipeos sync-media*)",
      "Bash(pipeos-selfcheck*)",
      "Bash(apk *)",
      "Bash(extra-add*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(sfdisk*)",
      "Bash(partx*)",
      "Bash(blockdev*)",
      "Bash(reboot*)",
      "Bash(poweroff*)",
      "Bash(halt*)",
      "Bash(rc-*)",
      "Bash(openrc*)",
      "Bash(pipe shutdown*)",
      "Bash(pipe set *)",
      "Read(/root/.pipe/**)",
      "Read(/root/.ssh/**)",
      "Read(/root/.abuild/**)",
      "Read(/root/.config/gh/**)",
      "Read(/root/.claude/.credentials.json)",
      "Edit(/etc/**)",
      "Edit(/media/usb/**)",
      "Edit(/root/.pipe/**)"
    ]
  }
}
