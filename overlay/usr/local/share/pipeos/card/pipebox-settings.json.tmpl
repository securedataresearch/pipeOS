{
  "model": "opus",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/data"],
    "allow": [
@@ROLE_ALLOW@@
      "Read(/data/**)",
      "Bash(pipeos secrets request *)",
      "Bash(sh -n *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(uptime*)",
      "Bash(jq *)",
      "Bash(pipe dm *)",
      "Bash(pipe room *)",
      "Bash(pipe lobby *)",
      "Bash(pipe wait *)",
      "Bash(pipe status*)",
      "Bash(pipe update*)",
      "Bash(pipe snapshot*)",
      "Bash(pipe contacts*)",
      "Bash(pipe cohorts board*)",
      "Bash(pipe claim*)",
      "Bash(pipe claims*)",
      "Bash(pipe --version)",
      "Bash(pipeos status*)",
      "Bash(pipeos verify*)",
      "Bash(pipeos diff*)",
      "Bash(pipeos snapshot ls*)",
      "Bash(pipebox-card verify*)",
      "Bash(pipebox-card show*)"
    ],
    "deny": [
      "Bash(git -c *)",
      "Bash(git config *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh auth token*)",
      "Read(/etc/pipeos/tls/**)",
      "Read(/etc/pipeos/users.json)",
      "Bash(cat /run/pipeos/secrets/*)",
      "Bash(head /run/pipeos/secrets/*)",
      "Bash(tail /run/pipeos/secrets/*)",
      "Bash(cat /etc/pipeos/users.json*)",
      "Bash(cat /etc/pipeos/tls/*)",
      "Bash(lbu*)",
      "Bash(pipeos-save*)",
      "Bash(pipeos save*)",
      "Bash(pipeos pkg*)",
      "Bash(pipeos rollback*)",
      "Bash(pipeos sync-media*)",
      "Bash(pipeos backup*)",
      "Bash(pipeos-backup*)",
      "Bash(pipeos flash*)",
      "Bash(pipeos-flash*)",
      "Bash(pipeos selfupdate*)",
      "Bash(pipeos-selfupdate*)",
      "Bash(pipeos restore-work*)",
      "Bash(pipeos-restore-work*)",
      "Bash(pipeos vault*)",
      "Bash(pipeos-vault*)",
      "Bash(pipeos cluster*)",
      "Bash(python3 /usr/local/share/pipeos/web/*)",
      "Bash(python3 /usr/local/share/pipeos/web*)",
      "Bash(pipeos-schedule-*)",
      "Bash(losetup*)",
      "Bash(pipeos deploy-overlay*)",
      "Bash(pipeos-deploy-overlay*)",
      "Bash(pipeos-selfcheck*)",
      "Bash(apk *)",
      "Bash(extra-add*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(sfdisk*)",
      "Bash(partx*)",
      "Bash(blockdev*)",
      "Bash(reboot*)",
      "Bash(poweroff*)",
      "Bash(halt*)",
      "Bash(rc-*)",
      "Bash(openrc*)",
      "Bash(pipe shutdown*)",
      "Bash(pipe set *)",
      "Read(/root/.pipe/**)",
      "Read(/root/.ssh/**)",
      "Read(/root/.abuild/**)",
      "Read(/root/.config/gh/**)",
      "Read(/root/.claude/.credentials.json)",
      "Read(/etc/pipeos/vault.sealed)",
      "Read(/run/pipeos/secrets/**)",
      "Edit(/etc/**)",
      "Edit(/media/usb/**)",
      "Edit(/root/.pipe/**)"
    ]
  }
}
