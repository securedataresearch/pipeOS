# pipebox runtime configuration — sourced by pipebox-listener, pipebox-gh-notify,
# and pipebox-report. Lives in /etc so it rides the apkovl.
#
# GENERATED by pipebox-card from /etc/pipeos/card.conf — do not edit.
# Edit the card and re-run `pipebox-card generate`; a hand edit here is
# detected by `pipebox-card verify` and lost at the next generation.
#
# The card's content hash lives in /etc/pipeos/.card-stamp rather than in this
# header, so that a change to a comment in the card does not rewrite every
# derived file. One place records provenance; verify reads that place.

# This box's own pipe nick. The listener tells the agent who it is; without it
# an agent cannot tell a message about itself from a message about a sibling.
NICK="@@NICK@@"

# This box's function in the pipeline (BUILD / TEST / SHIP, or empty).
# Advisory to the agent; the enforced fences are the settings file and the
# GitHub credential, not this string.
ROLE="@@ROLE@@"

# The only pipe nick whose requests authorize real work (see mandate.md).
# Empty = listener replies conversationally to no one and DMs go nowhere;
# fill in at sign-in time.
OWNER_NICK="@@OWNER_NICK@@"

# The nick the owner has placed above the boxes. Authorizes the same work the
# owner does, minus lifting hard bans and minus changing who the principals
# are. Empty = no Foreman, and the agent takes direction from the owner only.
FOREMAN_NICK="@@FOREMAN_NICK@@"

# The cohort board this box coordinates on. Read with `pipe cohorts board $COHORT_ID`.
COHORT_ID="@@COHORT_ID@@"

# GitHub owner whose repos the notify cron watches.
GH_OWNER="@@GH_OWNER@@"

# What this box must be able to BUILD (pipe#650 item 7), comma-separated.
# Empty = compiles nothing, and selfcheck skips the probe rather than passing
# it. Selfcheck compiles a real artifact per entry: a version string is not
# evidence, which three boxes with a broken linker demonstrated.
TOOLCHAIN="@@TOOLCHAIN@@"

# Repos this box is expected to have on disk (pipe#650 item 8), comma-separated.
# Selfcheck verifies each is present, is a git repo, and has the expected
# remote — a claim posted against a branch in a repo that was never cloned is
# what this closes.
REPOS="@@REPOS@@"

# /work disk-pressure thresholds, percent-used (pipeOS#41). Empty = selfcheck
# falls back to WARN 70 / CRIT 85. Declared per box because a 25G box and a
# 53G box hitting the same percentage have very different GB of headroom left.
DISK_WARN_PCT="@@DISK_WARN_PCT@@"
DISK_CRIT_PCT="@@DISK_CRIT_PCT@@"

# Reclamation interval, hours (pipeOS#41). Empty = pipeos-gc falls back to 24
# (once a day). Declared per box because accumulation rate, not just disk
# size, drives how often a proactive cargo-clean pass is worth running.
GC_INTERVAL_HOURS="@@GC_INTERVAL_HOURS@@"

# How stale this box's deployed overlay may get before selfcheck calls it
# CRITICAL, in days (pipeOS#97). Empty = the selfcheck fallback of 3. Any
# undeployed commit warns immediately; this is only where warn becomes crit.
# Card-declared because a box that runs the listener for the whole fleet is
# not as tolerant of a four-day-old fix as a spare on a shelf.
OVERLAY_CRIT_DAYS="@@OVERLAY_CRIT_DAYS@@"
