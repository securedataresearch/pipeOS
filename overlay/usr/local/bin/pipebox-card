#!/bin/sh
# pipebox-card — generate a box's identity from one declarative model card.
#
# For securedataresearch/pipe#650. A box's mandate, agent settings and runtime
# conf stop being things a human types onto each machine and become output of
# a card that is itself the record of what the box is.
#
#   pipebox-card generate [--card F] [--root D] [--strict]
#   pipebox-card verify   [--card F] [--root D]
#   pipebox-card show     [--card F]
#
# Exit codes are the point of `verify` and are a stable API:
#   0  derived files match the card
#   1  divergent — a hand edit, or a card changed since the last generation
#   2  cannot tell (no card, no stamp, unreadable template)
#
# 2 exists because "no card here" and "card matches" are different answers and
# a checker that returns 0 for both is the fail-open shape this repo has spent
# three PRs removing (#15, #16). Callers decide what to do about 2; this
# script will not decide for them by pretending it checked.

set -u

CARD=/etc/pipeos/card.conf
ROOT=/
TMPL=/usr/local/share/pipeos/card
STRICT=0

STAMP_REL=etc/pipeos/.card-stamp
OUTPUTS="etc/pipeos/pipebox.conf etc/pipeos/pipebox-settings.json etc/pipeos/mandate.md"

die()  { printf 'pipebox-card: %s\n' "$*" >&2; exit 2; }
ok()   { printf 'ok    %s\n' "$*"; }
bad()  { printf 'FAIL  %s\n' "$*"; }
note() { printf '      %s\n' "$*"; }

# ------------------------------------------------------------------ card
# Parsed, never sourced. A card is data that arrives with a machine — over
# HTTP from the boot server under #651 — so it must not be able to run code
# on the box that reads it.
NICK= ROLE= OWNER_NICK= FOREMAN_NICK= COHORT_ID= GH_OWNER= MAC=
TOOLCHAIN= REPOS=

read_card() {
    [ -r "$1" ] || die "card not readable: $1"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key=${line%%=*}
        val=${line#*=}
        [ "$key" != "$line" ] || die "card line is not KEY=value: $line"
        # strip one layer of quotes and surrounding blanks
        val=${val#"${val%%[![:space:]]*}"}
        val=${val%"${val##*[![:space:]]}"}
        case "$val" in \"*\") val=${val#\"}; val=${val%\"} ;; esac
        case "$key" in
            NICK|ROLE|OWNER_NICK|FOREMAN_NICK|COHORT_ID|GH_OWNER|MAC) ;;
            TOOLCHAIN|REPOS) ;;
            *) die "unknown card key: $key" ;;
        esac
        # Values land in sed expressions and in a shell-sourced conf file.
        # Refuse anything that is not a plain identifier rather than trying to
        # quote it correctly in three languages.
        #
        # The two list-valued keys (pipe#650 items 7-8) additionally allow a
        # comma, and ONLY a comma — it is inert in both destinations, unlike
        # the space that would be the obvious alternative. The widening is
        # per-key rather than global on purpose: the strict charset is what
        # keeps a card that arrives over HTTP from a boot server (#651) out of
        # the shell, and it should stay strict everywhere it can.
        case "$key" in
            TOOLCHAIN|REPOS)
                case "$val" in
                    *[!A-Za-z0-9_.:,-]*) die "card value for $key is not a comma-separated list of plain identifiers: $val" ;;
                    *,,*|,*|*,) die "card value for $key has an empty list element: $val" ;;
                esac
                ;;
            *)
                case "$val" in
                    *[!A-Za-z0-9_.:-]*) die "card value for $key is not a plain identifier: $val" ;;
                esac
                ;;
        esac
        eval "$key=\$val"
    done < "$1"

    case "$ROLE" in ''|BUILD|TEST|SHIP) ;; *) die "unknown ROLE: $ROLE" ;; esac
    case "$COHORT_ID" in ''|*[!0-9]*) [ -z "$COHORT_ID" ] || die "COHORT_ID must be numeric: $COHORT_ID" ;; esac

    if [ "$STRICT" = 1 ]; then
        for k in NICK ROLE OWNER_NICK FOREMAN_NICK COHORT_ID GH_OWNER; do
            eval "v=\$$k"
            [ -n "$v" ] || die "--strict: card is missing $k"
        done
        has_charter "$ROLE" || die "--strict: no role charter for ROLE=$ROLE"
    fi
}

# ------------------------------------------------------------- rendering
# Per-role allow entries. Deliberately thin: today's roles barely differ in
# what shell commands they need, and the fences that matter are the hard-ban
# deny list and the GitHub credential (#648), not this block.
#
# "TEST cannot push product code" is NOT expressible here and must not be
# attempted here: `git push` is one command whose legitimacy depends on the
# branch and the files, which a command allowlist cannot see. That fence lives
# at the platform, on the token. Two layers claiming the same rule is how a
# later reader ends up unable to tell which one is authoritative.
role_block() {
    case "$1" in
        BUILD|TEST)
            # BUILD authors, TEST runs the gate; both need the toolchain.
            printf '      "Bash(cargo *)",\n'
            printf '      "Bash(rustc *)",\n'
            printf '      "Bash(just *)",\n'
            ;;
        *) : ;;
    esac
}

# Per-role charter (pipeOS#35). ROLE used to expand to an allow-block and a
# token class and nothing else; what a role actually DOES lived as oral
# tradition on the board, and every out-of-lane incident this week traces to
# that gap. The charter is the varying block of an otherwise common mandate.
#
# This is prose the model obeys, so two rules govern edits: it states the lane
# and the handoffs, and it does NOT restate a fence that is enforced elsewhere
# as though the text were the enforcement. The charter says *why* the PAT
# fence exists so a box stops mistaking enforcement for the definition.
#
# The text is the Foreman's draft on pipeOS#35 and is pending the owner's
# blessing — the mandate is his document. Amending it is an edit to this
# function alone; no caller changes.
charter_block() {
    case "$1" in
        BUILD) cat <<'EOF'
Your ROLE is **BUILD** — the write lane.

- You author and land product code. Yours is the only PAT carrying Contents
  write. Push over HTTPS so the credential is the thing being checked; never
  reach for a side-channel remote.
- You land other roles' completed work unchanged — `git am` or a byte-identical
  transfer that preserves authorship. Their commit, your push.
- You never merge your own PRs. Two TEST verdicts plus green CI, and the
  Foreman merges.
- Branch per issue. Fix with new commits. `--force-with-lease` only to remove
  something that must not stay published, and disclose it in the same post.
- You may decline work; you must not take it. Assignment comes from the
  Foreman. The one standing exception is mechanical formatter output needed to
  green a gate.
EOF
            ;;
        TEST) cat <<'EOF'
Your ROLE is **TEST** — the verification lane, doubled because verification is
the scarce resource.

- You produce verdicts: LGTM or CHANGES, with the defect named concretely.
  Verify against an exact commit, say which SHA your verdict covers, and
  re-verify after any rewrite.
- Build the reproduction before the fix is written. A repro that discriminates
  between competing fixes outranks one that merely fails.
- Authoring conflicts you out of the verdict on your own work; the other TEST
  box carries it. Reach your verdict independently — do not coordinate it.
- You cannot push product code. That is your PAT, not a rule you are keeping,
  and it is deliberate. Hand patches to BUILD or the Foreman with the scope
  stated from `git status --short` — `git diff --stat` cannot see untracked
  files, which is how stray files reach a PR.
- State verification limits plainly: "diff-reviewed, not run-verified" when
  execution was unavailable. Silence is never a pass.
EOF
            ;;
        SHIP) cat <<'EOF'
Your ROLE is **SHIP** — release, pipeline health, and specification.

- You own CI and release-pipeline health: watch the gates, read the timing
  rows, call the regressions.
- You write the specs and design notes for work your read-only PAT bars you
  from implementing. The spec is the deliverable; BUILD types it in.
- Fixes you author route to BUILD or the Foreman to land. Never invent a
  workaround remote.
- You run the release verbs — `sync-media`, `save`, `verify` — when the
  Foreman calls the update.
EOF
            ;;
        *) cat <<'EOF'
Your ROLE is **unset**. This box is unprovisioned: its card names no role, so
nothing below has assigned you a lane.

Take direction from nobody and author nothing. Answer questions in text, say
plainly that you are unprovisioned, and ask for a card with a ROLE before
doing any work. An unprovisioned box guessing at a lane is the failure this
posture exists to prevent.
EOF
            ;;
    esac
    cat <<'EOF'

When you cannot tell whether an action is in your lane, ask on the board
instead of acting. "I would rather be told off for acting" was this week's
failure shape; the charter exists so that neither happens.
EOF
}

# True when $1 names a role this generator has a charter for. --strict refuses
# to write a mandate whose charter would silently fall through to the
# unprovisioned posture — a box told it has no lane when the card says BUILD is
# worse than a hard failure at generation time.
has_charter() {
    case "$1" in BUILD|TEST|SHIP) return 0 ;; *) return 1 ;; esac
}

render() {
    tmpl="$1"
    [ -r "$tmpl" ] || die "template not readable: $tmpl"
    sedexpr="s|@@NICK@@|$NICK|g
s|@@ROLE@@|$ROLE|g
s|@@OWNER_NICK@@|$OWNER_NICK|g
s|@@FOREMAN_NICK@@|$FOREMAN_NICK|g
s|@@COHORT_ID@@|$COHORT_ID|g
s|@@GH_OWNER@@|$GH_OWNER|g
s|@@TOOLCHAIN@@|$TOOLCHAIN|g
s|@@REPOS@@|$REPOS|g
s|@@CARD_SHA@@|$CARD_SHA|g"
    # Block markers occupy a line of their own and expand to generated text.
    # There are two now (#35 added the charter), so the head/tail split is a
    # loop rather than a single special case — the old form handled exactly one
    # marker and would have emitted the other verbatim into the model's own
    # instructions.
    #
    # Every variable here is _r-prefixed. This function has no `local` (POSIX
    # sh), so a plain name like `rc` is global and silently clobbers the
    # caller's — cmd_verify accumulates its failures in `rc` and calls
    # render_all halfway through, so a bare `rc` here turned a detected
    # hand-edit back into a PASS. Fail-open, in the one function whose exit
    # code is documented as a stable API.
    _rcur=$(mktemp) || die "mktemp failed"
    _rnxt=$(mktemp) || die "mktemp failed"
    cat "$tmpl" > "$_rcur" || die "read failed: $tmpl"
    for _rmark in @@ROLE_ALLOW@@ @@ROLE_CHARTER@@; do
        while grep -q "^$_rmark\$" "$_rcur"; do
            _rn=$(grep -n "^$_rmark\$" "$_rcur" | head -1 | cut -d: -f1)
            {
                head -n $((_rn - 1)) "$_rcur"
                case "$_rmark" in
                    @@ROLE_ALLOW@@)   role_block "$ROLE" ;;
                    @@ROLE_CHARTER@@) charter_block "$ROLE" ;;
                esac
                tail -n +$((_rn + 1)) "$_rcur"
            } > "$_rnxt" || die "render failed at $_rmark"
            cat "$_rnxt" > "$_rcur" || die "render failed at $_rmark"
        done
    done
    sed "$sedexpr" "$_rcur"
    _rrc=$?
    rm -f "$_rcur" "$_rnxt"
    return $_rrc
}

tmpl_for() {
    case "$1" in
        etc/pipeos/pipebox.conf)           echo "$TMPL/pipebox.conf.tmpl" ;;
        etc/pipeos/pipebox-settings.json)  echo "$TMPL/pipebox-settings.json.tmpl" ;;
        etc/pipeos/mandate.md)             echo "$TMPL/mandate.md.tmpl" ;;
        *) die "no template for $1" ;;
    esac
}

sha() { sha256sum "$1" | cut -d' ' -f1; }

# Render every output into $1, a directory, preserving relative paths.
render_all() {
    for rel in $OUTPUTS; do
        mkdir -p "$1/${rel%/*}" || die "mkdir failed under $1"
        render "$(tmpl_for "$rel")" > "$1/$rel" || die "render failed: $rel"
    done
    # mandate.md is fed to the model verbatim as a prompt, so it carries no
    # generator header — its provenance is the stamp, not a line of chatter
    # in the agent's own instructions.
    if command -v jq >/dev/null 2>&1; then
        jq -e . "$1/etc/pipeos/pipebox-settings.json" >/dev/null 2>&1 \
            || die "generated settings are not valid JSON — refusing to install"
    fi
}

# ------------------------------------------------------------- generate
cmd_generate() {
    read_card "$CARD"
    tmpd=$(mktemp -d) || die "mktemp failed"
    trap 'rm -rf "$tmpd"' EXIT INT TERM
    render_all "$tmpd"

    {
        echo "# generated by pipebox-card — regenerate, do not edit"
        echo "card sha256:$CARD_SHA"
        for rel in $OUTPUTS; do echo "$(sha "$tmpd/$rel")  $rel"; done
    } > "$tmpd/$STAMP_REL"

    for rel in $OUTPUTS $STAMP_REL; do
        dst="${ROOT%/}/$rel"
        mkdir -p "${dst%/*}" || die "mkdir failed for $dst"
        # write-then-rename: a power cut must not leave a half-written mandate,
        # which the listener would refuse to run on and the box would go quiet
        cp "$tmpd/$rel" "$dst.new" || die "write failed: $dst.new"
        mv "$dst.new" "$dst" || die "install failed: $dst"
        echo "wrote $dst"
    done

    # A card with a real NICK means this box has been provisioned. pipeos-save
    # gates on etc/pipeos/provisioned and silently exits 0 without it — so a
    # box brought up by the card path (no interactive login, hence
    # zz-pipeos-provision.sh never runs) would never persist anything: sign-in,
    # config, all lost at the next reboot. Set the marker here so the #650
    # headless path is actually durable. The empty default card (NICK unset)
    # leaves the box unprovisioned, as intended.
    if [ -n "$NICK" ]; then
        marker="${ROOT%/}/etc/pipeos/provisioned"
        [ -f "$marker" ] || { : > "$marker" && echo "wrote $marker"; }
    fi

    echo "pipebox-card: generated from $CARD (sha256:$CARD_SHA)"
    printf '%s\n' "note: nothing here survives a reboot until it is committed —" \
                  "      run 'pipeos save' (operator; hard-banned for the agent)."
}

# --------------------------------------------------------------- verify
cmd_verify() {
    stamp="${ROOT%/}/$STAMP_REL"
    if [ ! -r "$CARD" ]; then
        printf 'skip  no model card at %s — this box is not card-provisioned\n' "$CARD"
        note "cannot tell whether its config matches anything; exit 2"
        return 2
    fi
    [ -r "$stamp" ] || { printf 'skip  card present but no stamp at %s\n' "$stamp"
                         note "generate has never run here; exit 2"; return 2; }

    read_card "$CARD"
    rc=0

    # (a) is any derived file hand-edited since it was generated?
    while read -r want rel; do
        case "$want" in '#'*|card) continue ;; esac
        [ -n "${rel:-}" ] || continue
        f="${ROOT%/}/$rel"
        if [ ! -r "$f" ]; then bad "derived file missing: $f"; rc=1; continue; fi
        got=$(sha "$f")
        if [ "$got" = "$want" ]; then ok "unmodified since generation: $rel"
        else bad "hand-edited since generation: $rel"; rc=1; fi
    done < "$stamp"

    # (b) does the stamp still describe what this card would produce?
    stamped_card=$(sed -n 's/^card sha256://p' "$stamp" | head -1)
    if [ "$stamped_card" != "$CARD_SHA" ]; then
        bad "stale: card changed since generation (stamp $stamped_card, card $CARD_SHA)"
        note "run 'pipebox-card generate'"
        rc=1
    else
        ok "stamp matches the current card (sha256:$CARD_SHA)"
    fi

    # (c) byte-stability: regenerating from an unchanged card must reproduce
    # the same bytes, or (a) and (b) are both meaningless
    tmpd=$(mktemp -d) || die "mktemp failed"
    trap 'rm -rf "$tmpd"' EXIT INT TERM
    render_all "$tmpd"
    for rel in $OUTPUTS; do
        want=$(sed -n "s|^\([0-9a-f]*\)  $rel\$|\1|p" "$stamp" | head -1)
        [ -n "$want" ] || { bad "stamp has no entry for $rel"; rc=1; continue; }
        [ "$(sha "$tmpd/$rel")" = "$want" ] || {
            bad "generator is not byte-stable for $rel"; rc=1; }
    done
    [ "$rc" = 0 ] && ok "regeneration reproduces the stamped bytes"

    if [ "$rc" = 0 ]; then echo "card: PASS — derived files match the card"
    else echo "card: FAIL — derived files do not match the card"; fi
    return $rc
}

cmd_show() {
    read_card "$CARD"
    echo "card:        $CARD (sha256:$CARD_SHA)"
    for k in NICK ROLE OWNER_NICK FOREMAN_NICK COHORT_ID GH_OWNER MAC; do
        eval "v=\$$k"
        printf '%-12s %s\n' "$k:" "${v:-<unset>}"
    done
}

# ----------------------------------------------------------------- main
verb=${1:-}; [ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
    case "$1" in
        --card)      CARD=${2:?--card needs a path}; shift 2 ;;
        --root)      ROOT=${2:?--root needs a path}; shift 2 ;;
        --templates) TMPL=${2:?--templates needs a path}; shift 2 ;;
        --strict)    STRICT=1; shift ;;
        *) die "unknown option: $1" ;;
    esac
done

CARD_SHA=$([ -r "$CARD" ] && sha "$CARD" || echo none)

case "$verb" in
    generate) cmd_generate ;;
    verify)   cmd_verify ;;
    show)     cmd_show ;;
    *) cat >&2 <<'EOF'
usage: pipebox-card {generate|verify|show} [--card F] [--root D] [--templates D] [--strict]

  generate   write the derived files and their stamp
  verify     0 = matches the card, 1 = divergent, 2 = cannot tell
  show       print the resolved card
EOF
       exit 2 ;;
esac
