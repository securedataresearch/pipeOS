#!/bin/sh
# pipeos-selfcheck — boot-time health check: remediate, then report.
#
# Launched (backgrounded) by /etc/init.d/pipeos-selfcheck once the default
# runlevel is up. The 2026-08-05 power loss showed this box can come back
# wounded and silent: packages missing, daemons down, nobody told. This
# script fixes what it can, DMs the owner the verdict, and — only when
# nothing is CRITICAL — promotes the canonical apkovl to known-good.

# Only --boot (passed by the init.d hook) opts into changing anything. A bare
# hand-run observes and prints: it writes no file, starts no service, installs
# no package, touches neither /work nor the boot media, and sends no DM. Every
# remediation it declined is reported as "would fix", so read-only does not
# mean quiet. See pipeOS#13.
#
# Gating only the DM and the known-good promotion is not enough, which is what
# the first pass at #13 did: the mount fixup, the state-dir mkdir, consuming
# the clean-shutdown marker, the daemon starts and `apk fix` all ran before
# that gate, so a hand-run still mutated the box. #13 asks for "safe to run any
# time, by anyone, on any box", and that is the whole of it.
BOOT=no
case "$1" in
    --boot) BOOT=yes ;;
esac

LOG=/work/logs/selfcheck.log
MARKER=/work/.pipeos/clean-shutdown
FLAG=/work/pipebox/state/selfcheck-attention   # daily pipebox-report notices this
MEDIA=/media/usb
OVL=$MEDIA/pipeos.apkovl.tar.gz
KNOWN_GOOD=$MEDIA/pipeos.known-good.tar.gz

R=$(mktemp)
ncrit=0; nfix=0; nwarn=0; nwould=0
crit()  { echo "CRITICAL: $*" >> "$R"; ncrit=$((ncrit+1)); }
fixed() { echo "fixed: $*"    >> "$R"; nfix=$((nfix+1)); }
warnn() { echo "warn: $*"     >> "$R"; nwarn=$((nwarn+1)); }
# The hand-run counterpart to fixed(): names the remediation that was skipped
# rather than performing it. An operator inspecting a sick box needs to know
# what the boot path *would* have done — silence there reads as "nothing to
# fix", which is the same wrong answer #13 is about.
would() { echo "would fix: $*" >> "$R"; nwould=$((nwould+1)); }
log()   { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >> "$LOG" 2>/dev/null; }

# ---- 1. /work first — the marker and the log both live on it
if mountpoint -q /work; then
    :
elif [ "$BOOT" = yes ]; then
    # poll: device enumeration can lag well past service start
    _i=0
    until dev=$(findfs LABEL=PIPEWORK 2>/dev/null); do
        _i=$((_i+1)); [ "$_i" -ge 60 ] && break; sleep 1
    done
    [ -n "$dev" ] && mount -o noatime "$dev" /work 2>/dev/null
    if mountpoint -q /work; then
        fixed "/work was not mounted; mounted it"
    else
        crit "/work not mounted and could not mount it (LABEL=PIPEWORK missing?)"
    fi
else
    # Still CRITICAL — an unmounted /work is the condition, not the mount
    # attempt. The hand-run just reports it instead of correcting it, and
    # does not spend 60s polling for a device it will not mount.
    crit "/work not mounted"
    would "mount LABEL=PIPEWORK on /work"
fi
# Creating the state dirs is a write, so it waits for --boot too. Everything
# under them (LOG, FLAG) is written only on the boot path anyway.
[ "$BOOT" = yes ] && mkdir -p /work/.pipeos /work/logs /work/pipebox/state 2>/dev/null

# ---- 1b. /work is the declared block device, not just "something mounted
# there" (pipe#650 item 11). box0's /work was tmpfs silently masking an
# unmounted PIPEWORK partition; `mountpoint -q /work` was true the whole
# time, so section 1's check above would not have caught it — a tmpfs
# mount is still a mountpoint. LABEL=PIPEWORK is the declared device (same
# label section 1 already searches for); confirm the live backing device
# actually resolves to it. Read-only: this only reports, never remounts —
# swapping a live /work out from under running writes is not something a
# health check should do to itself.
if mountpoint -q /work; then
    _want=$(findfs LABEL=PIPEWORK 2>/dev/null)
    _have=$(findmnt -n -o SOURCE --target /work 2>/dev/null)
    if [ -z "$_want" ]; then
        crit "/work is mounted but LABEL=PIPEWORK does not resolve to any device"
    elif [ "$_have" != "$_want" ]; then
        crit "/work is mounted from ${_have:-unknown}, not the declared device $_want (LABEL=PIPEWORK) — writes may not persist across reboot"
    fi
fi

# ---- 2. how did the last run end? (marker readable only once /work is up)
if dmesg 2>/dev/null | grep -qi 'EXT4-fs.*recover'; then
    down="power loss / hard reset (ext4 journal recovery ran)"
elif [ -f "$MARKER" ]; then
    down="clean shutdown"
else
    down="unclean (no clean-shutdown marker; first boot on this scheme?)"
fi
# Consuming the marker is what makes it mean "the *last* run"; a hand-run
# that ate it would make the next boot report an unclean shutdown that never
# happened. Boot-only, and not merely because it is a write.
[ "$BOOT" = yes ] && rm -f "$MARKER" 2>/dev/null

# ---- 3. daemons (remediate: start what should be running)
# `status` observes; `start` mutates. Only the second waits for --boot, so a
# hand-run still reports a down daemon — which is the thing an operator ran
# this for.
for svc in pipe-daemon pipebox-listener; do
    if rc-service "$svc" status >/dev/null 2>&1; then
        :
    elif [ "$BOOT" != yes ]; then
        crit "$svc down"
        would "start $svc"
    elif rc-service "$svc" start >/dev/null 2>&1; then
        fixed "$svc was down; started it"
    else
        crit "$svc down and would not start"
    fi
done

# ---- 3b. auth: a live daemon with a revoked token is not healthy. Per
# pipe#641 it silently destroys every inbound sealed message, and it is
# exactly what stops the boot report (section 8) from reaching the owner —
# the same check feeds both. Boot mode gets the same patience section 8
# already gave a freshly-started daemon ("it may still be signing in"); a
# hand-run checks once, since there is no boot-time signin race to wait out.
# See pipeOS#19.
_i=0
while :; do
    authj=$(pipe status -o json 2>/dev/null)
    auth_ok=$(echo "${authj:-}" | jq -r '.status.authenticated // empty' 2>/dev/null)
    [ "$auth_ok" = "true" ] && break
    [ "$BOOT" != yes ] && break
    _i=$((_i+1)); [ "$_i" -ge 24 ] && break; sleep 5
done
if [ "$auth_ok" = "true" ]; then
    :
elif [ -n "$authj" ]; then
    aerr=$(echo "$authj" | jq -r '.status.auth_error // empty' 2>/dev/null)
    crit "pipe daemon unauthenticated${aerr:+ ($aerr)}"
else
    crit "pipe status did not answer (daemon down or still signing in)"
fi

# ---- 4. will a reboot reproduce this state? (covers the incident: media
# repo coherence, world resolution, all packages installed, apkovl readable)
# `pipeos verify` only reads; `apk fix` installs, so it is the boot-only half.
if vout=$(pipeos verify 2>&1); then
    :
elif [ "$BOOT" != yes ]; then
    crit "pipeos verify FAIL: $(echo "$vout" | grep '^FAIL' | head -3 | tr '\n' '; ')"
    would "run apk fix to repair the boot path from the media repos"
else
    apk fix >/dev/null 2>&1 && log "verify failed; ran apk fix"
    if vout=$(pipeos verify 2>&1); then
        fixed "boot path was broken; apk fix repaired it from the media repos"
    else
        crit "pipeos verify FAIL: $(echo "$vout" | grep '^FAIL' | head -3 | tr '\n' '; ')"
    fi
fi

# ---- 5. disk pressure (pipeOS#41). Thresholds are card-declared
# (DISK_WARN_PCT / DISK_CRIT_PCT) because a 53G box and a 25G box hitting the
# same percentage have very different GB of headroom left — box1 measured a
# single cargo incremental cache eating 24G (60% of ALL disk on that box) in
# one busy day, and nothing warned before the owner happened to look at a
# dashboard. Falls back to 70/85 when the card leaves them unset (unprovisioned
# boxes, or boxes not yet carrying this field), well below the old 90/95 that
# let box1 reach 79% in silence. /work also holds this agent's own state
# (/work/claude/projects — transcripts, file memory), so losing it is not just
# a stalled build, it is losing the box's ability to report the problem — the
# reason this is a crit near the top end and not just a warn.
_dp_conf=/etc/pipeos/pipebox.conf
[ -r "$_dp_conf" ] && . "$_dp_conf" 2>/dev/null
disk_warn=${DISK_WARN_PCT:-70}
disk_crit=${DISK_CRIT_PCT:-85}
use=$(df /work 2>/dev/null | awk 'NR==2{print $5+0}')
if [ "${use:-0}" -ge "$disk_crit" ] || [ "${use:-0}" -ge "$disk_warn" ]; then
    # Named, not just a percentage: "full-ish disk" with no culprit is exactly
    # how box1's 24G incremental cache went unnoticed. `du` here is read-only
    # (no writes, nothing mutated) and is only run once a threshold is already
    # crossed, so a healthy box never pays for it. Depth-1 under /work finds
    # the big-ticket subtree (e.g. repos/); a second pass one level into
    # repos/*/target catches the specific cargo cache pattern box1 found,
    # without hardcoding it as the only thing this check can name.
    top=$(du -xsk /work/*/ 2>/dev/null | sort -rn | head -1)
    topt=$(du -xsk /work/repos/*/target 2>/dev/null | sort -rn | head -1)
    culprit="top consumer: ${top:-unknown}"
    [ -n "$topt" ] && culprit="$culprit; ${topt}"
    if [ "${use:-0}" -ge "$disk_crit" ]; then
        crit "/work ${use}% full (>= ${disk_crit}% crit) — $culprit"
    else
        warnn "/work ${use}% full (>= ${disk_warn}% warn) — $culprit"
    fi
fi
free=$(df -k "$MEDIA" 2>/dev/null | awk 'NR==2{printf "%d", $4/1024}')
[ "${free:-0}" -lt 300 ] && warnn "boot media only ${free}MB free"

# ---- 5b. agent state layout. root/.claude/projects is meant to be a symlink
# onto /work so transcripts never reach the apkovl; lbu.list also excludes it
# defensively, but an unmigrated box should say so rather than silently bloat.
# A DANGLING link is worse than no link: agent memory is then unreachable.
#
# THE ABSENT CASE IS THE ONE THAT MATTERS AT BOOT, and it used to fall through
# both arms in silence (pipeOS#80). On an unmigrated box `projects` is a real
# directory, and lbu.list keeps it OUT of the apkovl — the `+root/.claude/
# projects` include is self-limiting (lbu's `_gen_filelist` re-adds a `+` path
# only when it is a symlink or a plain file) and the `-` line excludes the
# tree. So at boot the path does not exist at all: not a symlink, not a
# directory, and neither arm above fires. `claude` then creates it as a real
# directory on its first run, long after this check has already passed.
#
# That made this check structurally blind on exactly the boxes it exists to
# find. box3 booted 2026-08-10 20:28 and logged "all green" — the verdict is
# only "all green" when nwarn is 0 — while `/root/.claude/projects` was a real
# tmpfs directory the whole time. Three of four boxes are in that state.
#
# Absence is a clean signal precisely BECAUSE of the include above: on a
# migrated box the symlink itself rides in the apkovl and is restored, so it
# exists at boot. Absent here therefore means unmigrated, not "too early".
if [ -L /root/.claude/projects ]; then
    [ -d /root/.claude/projects/ ] || \
        crit "/root/.claude/projects symlink target missing — agent memory unreachable"
elif [ -d /root/.claude/projects ]; then
    warnn "/root/.claude/projects is a real directory, not a symlink onto /work — transcripts land in the apkovl (migrate copy-first: link-first destroys agent memory)"
elif [ -d /root/.claude ]; then
    # Guarded on /root/.claude existing so a box with no agent installed at
    # all stays quiet — this is about an agent box that is unmigrated, not
    # about every machine that has never run claude.
    warnn "/root/.claude/projects does not exist at boot — on a migrated box the symlink is restored from the apkovl, so its absence means this box is UNMIGRATED: claude will create a real directory on tmpfs and every transcript and memory file will die at the next reboot (pipeOS#80)"
fi

# ---- 5c. does this box still match its own model card? (pipe#650)
#
# `pipebox-card verify` is read-only and its exit codes are a stable API, so
# this is an observation and runs on the hand-run path too — same rule as
# `pipeos verify` above. There is no remediation half: regenerating writes
# /etc/pipeos/*, which is `pipebox-card generate`'s job under an operator, not
# something a health check should do to a running box behind its back.
#
# Exit 2 is deliberately NOT a failure. It means "cannot tell" — no card, or
# no stamp — which is exactly true of every box provisioned before the card
# path existed. Grading that as a fault would make the check cry wolf on the
# whole fleet on day one, and a check nobody believes is worse than no check.
if command -v pipebox-card >/dev/null 2>&1; then
    cout=$(pipebox-card verify 2>&1); crc=$?
    case "$crc" in
        0) : ;;
        1) crit "model card divergence: $(echo "$cout" | grep '^FAIL' | head -3 | tr '\n' '; ')"
           note_fix="run 'pipebox-card generate' (operator; it writes /etc)"
           [ "$BOOT" = yes ] || would "$note_fix" ;;
        *) warnn "cannot verify the model card (exit $crc) — not card-provisioned, or never generated" ;;
    esac
fi

# ---- 5d. cohort-watch could-not-start vs nothing-to-do (pipeOS#44)
#
# `pipebox-cohort-watch` (cron, every 2 min) drops a timestamp in
# cohort-*.startfail whenever `claude -p` fails to even start — rc 126/127
# (exec error) or rc=1, which is what a shared session-pool exhaustion looks
# like from here. That file is cleared on the next successful start. Its
# presence is exactly the "agent could not run" condition that pipeOS#44
# says must not look identical to "nothing to do": without it, an exhausted
# session pool and a quiet board are indistinguishable from outside the box.
#
# Read-only observation on both paths — there is nothing to remediate here,
# only to report; the fix is either the next cron tick succeeding on its own
# (rc=1/126/127 already retry without advancing $SEEN) or a human addressing
# the shared token. A stale startfail (older than 30 min, i.e. well past the
# 15-min backoff pipebox-cohort-watch uses for rc=1) means it's not just a
# single blip.
for sf in /work/pipebox/state/cohort-*.startfail; do
    [ -e "$sf" ] || continue
    ts=$(cat "$sf" 2>/dev/null)
    now=$(date -u +%s)
    if [ -n "$ts" ] && [ "$((now - ts))" -ge 1800 ] 2>/dev/null; then
        crit "cohort-watch ($sf): claude -p has failed to start for $(( (now - ts) / 60 ))min — agent could not run, not just idle (pipeOS#44)"
    else
        warnn "cohort-watch ($sf): claude -p failed to start on the last tick — agent could not run (pipeOS#44)"
    fi
done

# ---- 5e. apk index signing trust — loud, not silent (pipe#650 item 10).
# box0's /etc/apk/keys lacked the pipebox signing pubkey, so the index read
# UNTRUSTED and apk silently kept an old package version — no error, just a
# quiet pin. Read-only on both paths, same as 5c: this observes, it does not
# install a key (that is an operator/provisioning action, not a health-check
# remediation).
if [ -z "$(ls -A /etc/apk/keys 2>/dev/null)" ]; then
    crit "no apk signing keys in /etc/apk/keys — index reads UNTRUSTED and apk silently falls back to whatever is already installed"
else
    akout=$(apk update 2>&1)
    if echo "$akout" | grep -qi 'untrusted'; then
        crit "apk index UNTRUSTED: $(echo "$akout" | grep -i untrusted | head -3 | tr '\n' '; ')"
    fi
fi

# ---- 5f. default route present (pipe#650 item 12). Not a card field and not
# remediated here — udhcpc has been seen to drop the default route on link
# bounce (pipeOS#645) and the fix belongs in the base image/network config.
# This just makes the symptom visible instead of a silently degraded box.
if ! ip route show default 2>/dev/null | grep -q default; then
    warnn "no default route — network reachability degraded (udhcpc route-drop, see pipeOS#645)"
fi

# ---- 5g. the declared toolchain actually BUILDS (pipe#650 item 7).
#
# The acceptance criterion names its own counter-example: `cargo --version`
# answered fine on three boxes whose linker was broken, three times, so a
# version string is not evidence and this check does not accept one. It
# compiles a real artifact and looks for the artifact.
#
# Card-declared and skipped when empty: a TEST or SHIP box that compiles
# nothing must not be told its missing toolchain is a fault. Read-only in the
# sense that matters — it builds into a temp dir and removes it; it never
# installs, and provisioning a missing toolchain is the generator's job.
#
# A PURE-RUST PROBE IS NOT ENOUGH, and that is pipeOS#52 (found by box3).
# After a reboot box3 could still `rustc` a Rust file to a working binary while
# `cargo test` died in cc-rs on "stdint.h: No such file or directory" — the
# tmpfs root's libc headers were gone (machine notes §1: apk-added live, never
# in world). Compile and link both worked; the HEADER path was missing.
#
# So the probe this section exists to be — "a version string is not evidence" —
# was itself blind one layer down, on the exact box that proved it. A box
# declaring `cargo` is declaring it can build the workspace, and this workspace
# has C build scripts (ring is transitive to both relay crates). So `cargo`
# additionally requires a C compile of a file that includes a system header.
#
# Verified to discriminate rather than assumed: with the system include path
# hidden, the Rust probe still passes with a real artifact while the C probe
# fails with "no include path in which to search for stdint.h".
#
# THE PROBE RUNS A BARE `cc`, AND THAT IS DELIBERATE. It took three attempts
# to land on that, so the reasoning is recorded rather than left to be
# rediscovered by whoever next thinks it looks wrong.
#
# `/work/buildroot/env.sh` documents that buildroot's gcc needs
# `CFLAGS=--sysroot=/work/buildroot` to find libc headers, and exports it.
# That file is real, correct, and — this is the part that decides it —
# **NOTHING SOURCES IT**. `pipebox-cohort-watch` and `pipebox-listener`, the
# two scripts that start every unattended agent, each export
# `PATH=/work/buildroot/usr/bin:$PATH` and nothing else; a grep across
# `overlay/`, `scripts/` and `.github/` for `env.sh` or `CFLAGS` finds those
# PATH lines and no other caller.
#
# So a bare `cc` is EXACTLY what the agent gets. An earlier version of this
# check sourced env.sh, on the theory that it was the documented build
# procedure; that made the probe test an environment no agent ever runs in,
# which is the original blindness in mirror image — it would have reported
# healthy on a box whose agent genuinely cannot build. Reverted.
#
# The proof is box3: started by cohort-watch, its `cargo` died in cc-rs on
# exactly this, which is a measurement of the agent's environment rather than
# a hypothesis about it. A CRIT there is a TRUE positive.
#
# Note also that which way a bare `cc` goes is box-specific — box1 and box0
# have `/usr/include/stdint.h` on their tmpfs roots and box3 does not — so the
# check reports a real per-box difference rather than a fleet-wide constant.
#
# The live defect this leaves is not in this file: `pipebox-cohort-watch`'s own
# comment says putting buildroot on PATH lets "a BUILD/TEST box's agent run
# cargo/rustc/cc", which is false on box3, because PATH alone does not carry
# the sysroot. Either that script sources env.sh or the headers belong in
# `world`; both fix it, and this check reports the symptom under either.
_tc_conf=/etc/pipeos/pipebox.conf
[ -r "$_tc_conf" ] && . "$_tc_conf" 2>/dev/null
if [ -n "${TOOLCHAIN:-}" ]; then
    for _probe in $(echo "$TOOLCHAIN" | tr ',' ' '); do
        case "$_probe" in
            cargo|rustc)
                if ! command -v "$_probe" >/dev/null 2>&1; then
                    crit "card declares TOOLCHAIN=$_probe but $_probe is not on PATH"
                    continue
                fi
                _tcd=$(mktemp -d) || continue
                printf 'fn main() { println!("ok"); }\n' > "$_tcd/p.rs"
                # rustc is the link step for both names: a broken linker fails
                # here and answers a --version probe, which is the whole point.
                if rustc -o "$_tcd/p" "$_tcd/p.rs" >"$_tcd/err" 2>&1 && [ -x "$_tcd/p" ]; then
                    :
                else
                    crit "card declares TOOLCHAIN=$_probe and $_probe --version answers, but a real compile FAILS: $(head -2 "$_tcd/err" 2>/dev/null | tr '\n' ' ')"
                fi
                # cargo means "builds the workspace", and the workspace has C
                # build scripts. Rust alone passing proves nothing about them
                # (pipeOS#52). Only for cargo: a bare `rustc` declaration is a
                # narrower claim and this would be answering a question the
                # card did not ask.
                if [ "$_probe" = cargo ]; then
                    if ! command -v cc >/dev/null 2>&1; then
                        crit "card declares TOOLCHAIN=cargo but there is no cc — the workspace's C build scripts cannot run"
                    else
                        printf '#include <stdint.h>\nint main(void){ return (int)(uint8_t)0; }\n' > "$_tcd/p.c"
                        if cc -o "$_tcd/pc" "$_tcd/p.c" >"$_tcd/cerr" 2>&1 && [ -x "$_tcd/pc" ]; then
                            :
                        else
                            crit "card declares TOOLCHAIN=cargo and Rust compiles, but a C compile including <stdint.h> FAILS — build scripts (cc-rs) cannot build: $(head -2 "$_tcd/cerr" 2>/dev/null | tr '\n' ' ')"
                        fi
                    fi
                fi
                rm -rf "$_tcd"
                ;;
            *)
                if ! command -v "$_probe" >/dev/null 2>&1; then
                    crit "card declares TOOLCHAIN=$_probe but $_probe is not on PATH"
                elif ! "$_probe" --version >/dev/null 2>&1; then
                    crit "card declares TOOLCHAIN=$_probe but '$_probe --version' fails"
                else
                    # Named but with no build probe here: say so rather than
                    # let a PATH hit read as a verified toolchain.
                    warnn "card declares TOOLCHAIN=$_probe — present on PATH, but this check has no real-build probe for it, so it is NOT verified to compile"
                fi
                ;;
        esac
    done
fi

# ---- 5h. the declared repos are on disk and point where the card says
# (pipe#650 item 8). box0 posted a claim against a branch in `pipe` on a box
# with no `pipe` checkout at all; presence, git-ness and remote are each a
# different way that goes wrong.
#
# Fetch reachability is deliberately a warn, not a crit: the network is not
# this box's to guarantee and 5f already reports a missing route. A wrong
# remote IS a crit — it means work would land somewhere nobody is looking.
if [ -n "${REPOS:-}" ]; then
    for _repo in $(echo "$REPOS" | tr ',' ' '); do
        _rp=/work/repos/$_repo
        if [ ! -d "$_rp" ]; then
            crit "card declares REPOS=$_repo but $_rp does not exist — this box cannot work an issue in it"
        elif [ ! -e "$_rp/.git" ]; then
            crit "$_rp exists but is not a git repo"
        else
            _rem=$(git -C "$_rp" remote get-url origin 2>/dev/null)
            if [ -z "$_rem" ]; then
                crit "$_rp is a git repo with no 'origin' remote"
            elif ! echo "$_rem" | grep -q "$_repo"; then
                crit "$_rp origin is $_rem, which does not name $_repo — pushes would go somewhere unexpected"
            fi
        fi
    done
fi

# ---- 5i. is the box RUNNING the code it is developing? (pipeOS#79)
#
# Three times in one day the fleet found something merged and not installed:
# the watcher (#79 itself), the `pipe` binary (21 releases behind, so
# `pipe wait --only board` — merged in #639 — does not exist on any box), and
# two patches queued behind the same wall. Each was discovered by accident, by
# someone about to build a thing that already existed.
#
# **A merged, unshipped feature is indistinguishable from one never built.**
# That is the whole failure class, and nothing on the box says so. Every input
# to this check is already on disk, needs no network, and takes one command —
# it just was not being run.
#
# WARN, NOT CRIT, and deliberately. A box mid-development is SUPPOSED to have
# a repo ahead of its installed copy; that is not a fault, it is the job. What
# is worth reporting is the GAP, and how big it is, so nobody re-derives it
# from a rejected CLI flag an hour into a card.
#
# THE BASELINE IS `origin/main`, BOTH HALVES. The comment here used to say
# "both halves compare against the local checkout only", and it was wrong
# about both: the pipe half already read a ref, and the overlay half globbed
# the WORKTREE. A worktree baseline answers "do my current edits match what is
# installed" — loud while a box does its job, and SILENT for merged-and-never-
# deployed, which is the condition this section is named for. A box only holds
# a fresh copy of a script it is currently working on; every other file sits at
# whatever commit the checkout was left on, so `cmp` matched and the merge was
# invisible. #79's own three examples are all files the finding box was not
# working on. box0 and box2 each reproduced this independently (#91 review).
#
# `origin/main` is whatever the last fetch left, so this can be stale — a stale
# ref understates the gap rather than inventing one.
#
# WHAT IT MUST NEVER DO IS GO QUIET. An unrun check has to be distinguishable
# from a passing one, or this section reproduces the failure class it exists to
# report: on box0 the whole overlay half was skipped by one `-d` test and
# `pipeos-selfcheck` printed nothing — clean, on the exact question it was
# added to answer. So every path that cannot reach its baseline says which
# baseline it could not reach, and why.
#
# Still WARN and not CRIT, including the cannot-check paths. 5h above already
# CRITs a repo the card declares and the box does not have, and restating the
# same fact at a higher severity buys nothing; what is new here is only that
# the DETECTOR is blind, which is a warning about an instrument.

# Repo paths come from the card's `REPOS`, the same source 5h uses. This
# section used to hardcode `/work/repos/pipe` and `/work/repos/pipeOS`, which
# is how the entire overlay half silently did not run on a box whose clones
# live elsewhere. One file, two conventions, and the hardcoding one is the one
# that went quiet.
_repo_dir() {
    for _r in $(echo "${REPOS:-}" | tr ',' ' '); do
        if [ "$_r" = "$1" ]; then echo "/work/repos/$_r"; return; fi
    done
}

_pipe_repo=$(_repo_dir pipe)
if [ -z "$_pipe_repo" ]; then
    warnn "cannot compare the installed pipe against main — the card's REPOS (${REPOS:-<unset>}) does not name 'pipe', so the version gap is unmeasured rather than zero (pipeOS#79)"
elif [ ! -d "$_pipe_repo/.git" ]; then
    warnn "cannot compare the installed pipe against main — $_pipe_repo is not a git repo, so the version gap is unmeasured rather than zero (pipeOS#79)"
elif ! command -v pipe >/dev/null 2>&1; then
    warnn "cannot compare the installed pipe against main — no 'pipe' on PATH (pipeOS#79)"
else
    _v_run=$(pipe --version 2>/dev/null | awk '{print $NF}')
    _v_repo=$(git -C "$_pipe_repo" show origin/main:Cargo.toml 2>/dev/null \
        | awk -F'"' '/^version = "/ {print $2; exit}')
    if [ -z "$_v_run" ]; then
        warnn "cannot compare the installed pipe against main — 'pipe --version' produced nothing (pipeOS#79)"
    elif [ -z "$_v_repo" ]; then
        warnn "cannot compare the installed pipe against main — 'git show origin/main:Cargo.toml' in $_pipe_repo produced nothing; origin/main is missing or was never fetched, so the version gap is unmeasured rather than zero (pipeOS#79)"
    elif [ "$_v_run" != "$_v_repo" ]; then
        warnn "installed pipe is $_v_run but origin/main declares $_v_repo — this box is not running the code it is developing, so a feature merged in between exists in the repo and not on the box (pipeOS#79)"
    fi
fi

# The overlay half. This is #79's own finding: the running watcher had
# features `main` did not, so a routine deploy would have REVERTED them.
# Compared by content rather than by mtime, because a deploy rewrites both.
#
# THREE BUCKETS, THREE MESSAGES, because the repairs differ and a single
# "differs" line sends the reader to the wrong one:
#
#   absent    — in origin/main, not on the box       -> deploy
#   unshipped — origin/main differs from installed   -> deploy
#   local     — worktree differs from origin/main    -> commit or revert
#
# The worktree comparison is kept rather than dropped: it is a real deploy-
# safety check and it is how #79's watcher features were nearly reverted. It
# just is not the detector, and it must not stand in for it.
#
# The file list comes from `ls-tree origin/main`, not from a worktree glob, so
# a script merged to main and not yet in this checkout is VISIBLE rather than
# skipped — which is the same class of miss one level down.
_ov_repo=$(_repo_dir pipeOS)
_ov_sub=overlay/usr/local/bin
if [ -z "$_ov_repo" ] || [ ! -d "$_ov_repo/.git" ]; then
    warnn "cannot compare the installed overlay scripts against main — no pipeOS checkout (REPOS=${REPOS:-<unset>}); a merged-but-undeployed script is unchecked here, not absent (pipeOS#79)"
else
    _base=origin/main
    _names=$(git -C "$_ov_repo" ls-tree --name-only "origin/main:$_ov_sub" 2>/dev/null)
    if [ -z "$_names" ]; then
        # Named fallback rather than a skip: something is still better than
        # silence, but the reader has to know it cannot see a merge.
        _base=worktree
        _names=$(ls "$_ov_repo/$_ov_sub" 2>/dev/null)
        [ -z "$_names" ] || \
            warnn "cannot resolve origin/main:$_ov_sub in $_ov_repo — comparing against the WORKTREE instead, which cannot see a script that merged and was never deployed (pipeOS#79)"
    fi
    _absent=""; _unshipped=""; _local=""; _unreadable=""
    _ref=$(mktemp)
    for _n in $_names; do
        _inst=/usr/local/bin/$_n
        _wt=$_ov_repo/$_ov_sub/$_n
        if [ "$_base" = origin/main ]; then
            git -C "$_ov_repo" show "origin/main:$_ov_sub/$_n" > "$_ref" 2>/dev/null
            # An empty read is unreadable, not empty-and-equal: comparing it
            # would report every such file as drifted.
            if [ ! -s "$_ref" ]; then _unreadable="$_unreadable $_n"; continue; fi
        else
            [ -f "$_wt" ] || continue
            cp "$_wt" "$_ref" 2>/dev/null || continue
        fi
        if [ ! -e "$_inst" ]; then
            _absent="$_absent $_n"
        elif ! cmp -s "$_ref" "$_inst"; then
            _unshipped="$_unshipped $_n"
        fi
        if [ "$_base" = origin/main ] && [ -f "$_wt" ] && ! cmp -s "$_ref" "$_wt"; then
            _local="$_local $_n"
        fi
    done
    rm -f "$_ref"
    [ -z "$_absent" ] || \
        warnn "overlay scripts in $_base but NOT INSTALLED on this box:$_absent — merged and never deployed; the repair is a deploy (pipeOS#79)"
    [ -z "$_unshipped" ] || \
        warnn "installed overlay scripts differ from $_base:$_unshipped — merged and never deployed; the repair is a deploy, not an edit (pipeOS#79)"
    [ -z "$_local" ] || \
        warnn "local overlay edits not in origin/main:$_local — the repair is to commit or revert them, and until then a deploy would replace the running version, which is how #79's watcher features were nearly reverted"
    [ -z "$_unreadable" ] || \
        warnn "cannot read origin/main:$_ov_sub/… for:$_unreadable — those scripts are unchecked, not clean (pipeOS#79)"
fi

# ---- 6. known-good promotion: this apkovl booted and nothing is critical.
# Warnings (e.g. a full-ish disk) do not block promotion — they don't make
# the *state* bad, and blocking on them would freeze known-good forever.
# Boot-only: a hand-run must never mutate the boot media.
promoted=no
skipped_promotion=no
if [ "$BOOT" = yes ] && [ "$ncrit" -eq 0 ] && [ -f "$OVL" ]; then
    (
        exec 9> /run/pipeos-save.lock
        _i=0
        until flock -n 9; do
            _i=$((_i+1)); [ "$_i" -ge 60 ] && exit 1; sleep 1
        done
        if [ -f "$KNOWN_GOOD" ] && \
           [ "$(sha256sum "$OVL" | cut -d' ' -f1)" = "$(sha256sum "$KNOWN_GOOD" | cut -d' ' -f1)" ]; then
            exit 0    # already promoted
        fi
        mount -o remount,rw "$MEDIA" || exit 1
        cp "$OVL" "$KNOWN_GOOD.new" && sync && mv "$KNOWN_GOOD.new" "$KNOWN_GOOD" && sync
        rc=$?
        rm -f "$KNOWN_GOOD.new"
        sync; mount -o remount,ro "$MEDIA" 2>/dev/null
        exit $rc
    ) && promoted=yes
elif [ "$BOOT" != yes ] && [ "$ncrit" -eq 0 ]; then
    skipped_promotion=yes
fi

# ---- 7. compose the report
verdict="all green"
[ "$nwarn" -gt 0 ] && verdict="green with $nwarn warning(s)"
[ "$nwould" -gt 0 ] && verdict="needs $nwould remediation(s) — none applied (hand-run)"
[ "$nfix" -gt 0 ] && verdict="recovered ($nfix fix(es) applied)"
[ "$ncrit" -gt 0 ] && verdict="DEGRADED — $ncrit critical"

msg="pipeos boot report [$(hostname)] $(date -u '+%Y-%m-%d %H:%MZ')
went down: $down
verdict: $verdict"
[ -s "$R" ] && msg="$msg
$(cat "$R")"
[ "$promoted" = yes ] && msg="$msg
apkovl promoted to known-good"
[ "$skipped_promotion" = yes ] && msg="$msg
apkovl promotion skipped (hand-run — rerun with --boot to apply it)"
[ "$BOOT" != yes ] && msg="$msg
hand-run: nothing was changed — no writes, no services started, no packages
installed, boot media untouched, owner not DMed. Rerun with --boot to apply."

# ---- 7b. a hand-run only ever prints; the boot path also logs and DMs.
echo "$msg"

[ "$BOOT" = yes ] || { rm -f "$R"; exit 0; }

log "boot selfcheck: $verdict (down: $down)"
[ -s "$R" ] && sed 's/^/  /' "$R" >> "$LOG"

# ---- 8. tell the owner. Gated on authenticated == true (section 3b already
# waited out the signin race), not on pipe status merely answering — an
# unauthenticated daemon answers pipe status fine and cannot send. See
# pipeOS#19: this was the circularity, the boot report failing for the same
# reason it needed sending, with no way to tell which of three causes it was.
. /etc/pipeos/pipebox.conf 2>/dev/null || true
export HOME=/root
export PIPE_AGENT=pipebox
export PIPE_NO_SPAWN=1
sent=no
if [ -n "$OWNER_NICK" ] && [ "$auth_ok" = "true" ]; then
    pipe dm "$OWNER_NICK" "$msg" >/dev/null 2>&1 && sent=yes
fi
if [ "$sent" = no ]; then
    # leave a breadcrumb the daily pipebox-report will surface
    { echo "undelivered boot report:"; echo "$msg"; } > "$FLAG" 2>/dev/null
    if [ -z "$OWNER_NICK" ]; then
        cause="no OWNER_NICK configured"
    elif [ "$auth_ok" != "true" ]; then
        aerr=$(echo "${authj:-}" | jq -r '.status.auth_error // empty' 2>/dev/null)
        cause="daemon unauthenticated${aerr:+ ($aerr)}"
    else
        cause="pipe dm send failed"
    fi
    log "owner DM not delivered: $cause"
fi

rm -f "$R"
exit 0
