#!/bin/sh
# pipebox-gh-notify — notify-only GitHub-issues channel (owner's decision:
# no autonomous work from issues). Polls issues across $GH_OWNER repos and
# DMs the owner a one-line summary per new/updated issue. Cursor keeps it
# incremental; silent no-op when offline or not signed in.
#
# pipeOS#88: this used to drop issues. `head -10` cut the DM, the log printed
# the MATCHED count beside the cut list ("sent 20 issue(s)" when ten went),
# and the cursor then advanced past all twenty — so the ten that were cut were
# never retried. A second cut sat above it: --limit bounded the search, and
# with the default best-match order the twenty that came back were not the
# twenty oldest, so anything the search left behind was also skipped.
#
# The fix is one property: THE CURSOR NEVER PASSES AN ISSUE THAT WAS NOT SENT.
# Everything else follows from it —
#
#   * --sort updated --order asc, so what the search returns is a prefix in
#     time. Without this the returned set has holes and no cursor value is
#     safe; with it, "everything up to T" is a claim the data supports.
#   * the batch is the OLDEST MAX_ITEMS, extended to cover every issue sharing
#     the last one's timestamp. The extension is what lets the cursor use `>`
#     without dropping the issues that share that second.
#   * the cursor becomes that timestamp, not `now`, whenever anything was held
#     back. The remainder is re-found next tick because it is still `>` it.
#
# And the DM says which of those it is, because a windowed read that looks
# complete is the whole defect (the #658 class, on the one channel the owner
# reads GitHub through — there is no second surface to catch a miss here).
#
# The one qualification on that property, because an unqualified absolute here
# would be false (box2 on #95): the search itself has a cut, at SEARCH_LIMIT.
# When a full page ENDS inside a tie group, the issues that fell off the page
# were never enumerated, so no cursor value can be proven safe. The cursor then
# stops before that second — or, if the whole page is one second, does not move
# at all. Those issues are not passed, but they are not reachable either until
# SEARCH_LIMIT exceeds the number of issues touched in that second, and the DM
# says so in as many words. Lossless, not always progressing.

. /etc/pipeos/pipebox.conf 2>/dev/null || true
[ -n "$OWNER_NICK" ] || exit 0
[ -n "$GH_OWNER" ] || exit 0

export HOME=/root
export PIPE_AGENT=pipebox
export PIPE_NO_SPAWN=1

STATE=/work/pipebox/state
CURSOR="$STATE/gh-cursor"
LOG=/work/logs/pipebox-gh-notify.log
mkdir -p "$STATE" /work/logs || exit 0

# How many the search may return, and how many one DM may carry. They are
# different numbers on purpose: LIMIT bounds the query, MAX_ITEMS bounds the
# message, and the gap between them is the backlog that rides to the next
# tick instead of being discarded.
SEARCH_LIMIT=20
MAX_ITEMS=10

exec 9> /run/pipebox-gh-notify.lock
flock -n 9 || exit 0

since=$(cat "$CURSOR" 2>/dev/null)
[ -n "$since" ] || since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# R21: scope the poll to the card's repos (REPOS via pipebox.conf), not the
# whole owner — a box that only works pipe must not be woken for pipeOS.
repo_args=""
for _r in $(printf '%s' "${REPOS:-pipe}" | tr ',' ' '); do
    repo_args="$repo_args --repo $GH_OWNER/$_r"
done
issues=$(gh search issues $repo_args --updated ">${since}" \
    --sort updated --order asc \
    --json repository,number,title,url,updatedAt --limit "$SEARCH_LIMIT" \
    2>>"$LOG") || exit 0

# Sorted here as well as asked for above. The flag is what makes the set a
# prefix in time; this makes the ORDER WITHIN IT something the batch maths can
# rely on rather than something a future flag change can quietly take away.
sorted=$(printf '%s' "$issues" | jq -c 'sort_by(.updatedAt)' 2>/dev/null) || exit 0
found=$(printf '%s' "$sorted" | jq 'length' 2>/dev/null) || exit 0

if [ "$found" -gt 0 ] 2>/dev/null; then
    # The oldest MAX_ITEMS, then extended forward over anything with the same
    # updatedAt as the last of them. On a sorted array `select(<= $t)` is that
    # prefix, so the batch is >= MAX_ITEMS and ends on a timestamp boundary.
    #
    # The extension is UNBOUNDED, so MAX_ITEMS is a floor on the batch, not a
    # cap on the DM: a bulk relabel that touches 20 issues in one second sends
    # all 20 in one message. That is the correct trade — ending mid-second is
    # the bug this file exists to fix — but it is a consequence worth stating
    # rather than discovering. (box0 on #95)
    batch=$(printf '%s' "$sorted" | jq -c --argjson n "$MAX_ITEMS" '
        if length <= $n then .
        else (.[$n - 1].updatedAt) as $t | [ .[] | select(.updatedAt <= $t) ]
        end' 2>/dev/null) || exit 0
    sent=$(printf '%s' "$batch" | jq 'length' 2>/dev/null) || exit 0
    last_ts=$(printf '%s' "$batch" | jq -r '.[-1].updatedAt' 2>/dev/null) || exit 0

    # Two independent facts, and neither substitutes for the other (#658):
    #   held    — found more than one DM carries; the rest are queued, not lost
    #   at_cap  — the search returned exactly its limit, so the TRUE total is
    #             unknown. Not "large": unknown. A tick can be at_cap with
    #             nothing held, and that still means numbers are missing.
    held=0
    at_cap=0
    [ "$sent" -lt "$found" ] && held=1
    [ "$found" -ge "$SEARCH_LIMIT" ] && at_cap=1

    # The tie extension guards the cut at MAX_ITEMS. Nothing guarded the cut at
    # SEARCH_LIMIT, and that one drops issues by the very mechanism #88 is
    # about: when the search returns its full limit, its LAST timestamp may
    # itself be a truncated tie group — more issues share that second than the
    # page had room for — and advancing the cursor onto it makes `>` skip every
    # one of them, permanently. (box0 on #95)
    #
    # Only the BATCH's own last second is at risk, and only when it is also the
    # search's last. If the batch ends earlier, the page contains a strictly
    # later item, so every issue sharing the batch's last second is present and
    # that second is proven exhausted.
    search_last_ts=$(printf '%s' "$sorted" | jq -r '.[-1].updatedAt' 2>/dev/null) || exit 0
    unverified=0
    cursor_ts="$last_ts"
    if [ "$at_cap" = 1 ] && [ "$last_ts" = "$search_last_ts" ]; then
        unverified=1
        # Everything strictly before the unverified second IS verified: the
        # page proved those seconds complete by containing a later one.
        verified=$(printf '%s' "$batch" | jq -c --arg t "$last_ts" \
            '[ .[] | select(.updatedAt < $t) ]' 2>/dev/null) || exit 0
        if [ "$(printf '%s' "$verified" | jq 'length' 2>/dev/null)" -gt 0 ] 2>/dev/null; then
            cursor_ts=$(printf '%s' "$verified" | jq -r '.[-1].updatedAt' 2>/dev/null) || exit 0
        else
            # The whole page is one second. There is NO safe cursor: any value
            # either repeats this page or skips part of a second we never saw.
            # Empty means "do not move it" below.
            cursor_ts=
        fi
    fi
    # Note the batch itself is still sent in full — nothing is withheld. Only
    # the cursor stops short, so the unverified second is re-queried next tick.
    # That repeats some issues; repeating is noise, and skipping is data loss.

    if [ "$held" = 1 ]; then
        header="[gh] $sent of $found changed issues, oldest first — the rest follow next tick"
    else
        header="[gh] $sent changed issue(s)"
    fi
    [ "$at_cap" = 1 ] && header="$header
[gh] the search returned its full limit of $SEARCH_LIMIT — the true total is unknown"
    if [ "$unverified" = 1 ] && [ -n "$cursor_ts" ]; then
        header="$header
[gh] $last_ts may be cut off mid-second, so the cursor stops before it — expect some of these again next tick"
    elif [ "$unverified" = 1 ]; then
        # Every issue on a full page shares one second. This is the one case
        # cursor arithmetic cannot rescue: a strict `>` cursor at second
        # granularity has no value between "repeat this page" and "skip part of
        # a second nothing ever enumerated". Holding still is the lossless half
        # of an unfixable choice, and the tick CANNOT make progress — so say
        # that, rather than let a stuck channel read as a quiet one.
        header="$header
[gh] all $sent of these share $last_ts and the page came back full — a '>' cursor cannot page inside a single second, so this tick cannot advance and any further issues in that second are unreachable. Raise SEARCH_LIMIT above the number of issues touched in that second, or query it directly."
    fi

    body=$(printf '%s' "$batch" | jq -r \
        '.[] | "[gh] \(.repository.nameWithOwner)#\(.number) \(.title) \(.url)"' \
        2>/dev/null) || exit 0

    if pipe dm "$OWNER_NICK" "$header
$body" >>"$LOG" 2>&1; then
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) sent $sent of $found found (held=$held at_cap=$at_cap unverified=$unverified) cursor=${cursor_ts:-<held back>}" >> "$LOG"
    else
        # DM failed (offline, rate-limited): leave cursor alone, retry next run
        exit 0
    fi

    # The whole point. Advance only to what actually went out whenever the
    # tick was short of the full picture — `>` next time re-finds the rest,
    # and nothing that was not sent is behind the cursor.
    if [ "$held" = 1 ] || [ "$at_cap" = 1 ]; then
        # Empty cursor_ts means no verified second exists in this page. Leaving
        # the cursor exactly where it was is the only lossless option.
        [ -n "$cursor_ts" ] && printf '%s\n' "$cursor_ts" > "$CURSOR"
        exit 0
    fi
fi

echo "$now" > "$CURSOR"
