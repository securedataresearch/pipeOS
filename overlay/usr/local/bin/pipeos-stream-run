#!/bin/bash
# pipeos-stream-run — browser-source capture for pipeos-stream's "browser" mode.
#
# Renders STREAM_URL in headless Chromium on a virtual X display and encodes the
# framebuffer to one or two RTMP targets (e.g. YouTube + Twitch) with ffmpeg's
# tee muxer. This exists because a page is not a media stream: `ffmpeg -i <url>`
# can only copy an actual A/V feed, and basho.dev (the motivating case) is a JS
# web app that has to be *rendered* to become video.
#
# Run under supervise-daemon (see /etc/init.d/pipeos-stream). It starts Xvfb,
# Chromium and ffmpeg, then blocks on `wait -n` and returns the moment ANY of
# them exits, tearing the set down together — so a dead renderer never leaves
# ffmpeg pushing a frozen/black frame; supervise-daemon then respawns the whole
# pipeline as a unit.
#
# Config (/etc/pipeos/stream.conf, shell-sourced, mode 600 — keys are secrets):
#   STREAM_URL          page to render (browser mode)
#   STREAM_DST/KEY      target 1 (e.g. rtmp://a.rtmp.youtube.com/live2 + key)
#   STREAM_DST2/KEY2    target 2, optional (e.g. rtmp://live.twitch.tv/app + key)
#   STREAM_RES          canvas + capture size, default 1920x1080
#   STREAM_FPS          frame rate, default 30
#   STREAM_VAAPI        1 = hardware H.264 on the iGPU, else software x264
#   STREAM_CHROME_ARGS  extra Chromium flags (GL tuning at deploy, optional)
#   STREAM_ARGS         extra ffmpeg args before the tee output, optional
set -u

CONF=/etc/pipeos/stream.conf
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

URL=${STREAM_URL:-}
RES=${STREAM_RES:-1920x1080}
FPS=${STREAM_FPS:-30}
W=${RES%x*}
H=${RES#*x}
DPY=99

if [ -z "$URL" ]; then
	echo "pipeos-stream-run: STREAM_URL is empty — nothing to render" >&2
	exit 1
fi

# Assemble the tee destination list from the managed provider slots. Each slot
# N (1..STREAM_MAX_TARGETS) is STREAM_T{N}_URL / STREAM_T{N}_KEY / STREAM_T{N}_ON
# — the dashboard writes these from a provider list (YouTube, Twitch, …). A slot
# streams only when it is ON and has a URL. onfail=ignore + use_fifo (below)
# keep one target's hiccup from stuttering the others.
# Force plain rtmp:// targets to IPv4. Home networks routinely hand out an IPv6
# address with no working route; ffmpeg (on musl, which ignores gai.conf) then
# tries the AAAA record first and hangs, and the whole stream reaches nobody.
# rtmp:// carries no TLS/SNI, so connecting by IP is fine; rtmps:// needs the
# hostname for SNI and is left alone (working IPv6, or a fixed route, is on it).
resolve4() {
	case "$1" in
	rtmp://*)
		rest=${1#rtmp://}; host=${rest%%/*}; path=${rest#*/}
		hostonly=${host%%:*}; port=""
		case "$host" in *:*) port=":${host#*:}" ;; esac
		ip=$(getent ahostsv4 "$hostonly" 2>/dev/null | awk 'NR==1{print $1}')
		[ -n "$ip" ] && printf 'rtmp://%s%s/%s' "$ip" "$port" "$path" || printf '%s' "$1" ;;
	*) printf '%s' "$1" ;;
	esac
}
# Each enabled slot may carry its own bitrate (STREAM_T{N}_BR, default
# STREAM_BITRATE). Targets sharing a bitrate share ONE encode (teed); each
# distinct bitrate gets its own encoder branch off a frame split — this is
# what lets Twitch take 6000k while YouTube's re-encoder gets a fat 9000k
# master from the same capture, without a second capture or process.
BRDEF="${STREAM_BITRATE:-3500k}"
T_DEST=""  # newline-separated "bitrate<TAB>[f=flv]url/key" rows
i=1
while [ "$i" -le "${STREAM_MAX_TARGETS:-4}" ]; do
	eval "on=\${STREAM_T${i}_ON:-}"
	eval "url=\${STREAM_T${i}_URL:-}"
	eval "key=\${STREAM_T${i}_KEY:-}"
	eval "br=\${STREAM_T${i}_BR:-}"
	if [ "$on" = 1 ] && [ -n "$url" ]; then
		url=$(resolve4 "${url%/}")
		T_DEST="${T_DEST}${br:-$BRDEF}	[f=flv]${url}${key:+/$key}
"
	fi
	i=$((i + 1))
done
# Back-compat: honour the old single/dual DST fields if no slot is set.
if [ -z "$T_DEST" ] && [ -n "${STREAM_DST:-}" ]; then
	T_DEST="$BRDEF	[f=flv]${STREAM_DST%/}${STREAM_KEY:+/$STREAM_KEY}
"
	[ -n "${STREAM_DST2:-}" ] && T_DEST="${T_DEST}$BRDEF	[f=flv]${STREAM_DST2%/}${STREAM_KEY2:+/$STREAM_KEY2}
"
fi
if [ -z "$T_DEST" ]; then
	echo "pipeos-stream-run: no enabled stream targets configured" >&2
	exit 1
fi
# distinct bitrates, first-seen order, and each one's teed dest list
# (BR_GROUPS, not GROUPS — bash reserves GROUPS for the user's gids and
# silently ignores assignments to it; cost one very confused dry run)
BR_GROUPS=()
while IFS='	' read -r br dest; do
	[ -n "$br" ] || continue
	found=""
	for g in "${BR_GROUPS[@]:-}"; do [ "$g" = "$br" ] && found=1; done
	[ -z "$found" ] && BR_GROUPS+=("$br")
done <<< "$T_DEST"
dests_for() {
	out=""
	while IFS='	' read -r br dest; do
		[ "$br" = "$1" ] && out="${out:+$out|}$dest"
	done <<< "$T_DEST"
	printf '%s' "$out"
}

export DISPLAY=":$DPY"
# De-rooted (svc-stream) runs get a writable HOME the init prepared; root
# keeps /root. Chromium refuses to start without a writable ~/.config.
if [ -w /work/cache/stream ]; then
	export HOME=/work/cache/stream
else
	export HOME=/root
fi
export XDG_CONFIG_HOME="$HOME/.config" XDG_CACHE_HOME="$HOME/.cache"

# Virtual framebuffer. Noise to /dev/null — ffmpeg's stderr is the signal the
# health probe reads, and we don't want Xvfb/Chromium drowning it in the log.
Xvfb ":$DPY" -screen 0 "${W}x${H}x24" -nolisten tcp >/dev/null 2>&1 &
XPID=$!
sleep 1

# Headless Chromium, kiosk fullscreen. --no-sandbox is required running as root
# on a minimal box; software GL keeps the GPU free for the encoder; a throwaway
# incognito profile in tmpfs so nothing persists across respawns. GL flags are
# the version-sensitive part — STREAM_CHROME_ARGS lets us tune at deploy.
PROFILE=$(mktemp -d /tmp/pipeos-chromium.XXXXXX)
# shellcheck disable=SC2086
chromium \
	--no-sandbox --kiosk --start-fullscreen --incognito \
	--no-first-run --no-default-browser-check \
	--user-data-dir="$PROFILE" \
	--window-size="${W},${H}" --window-position=0,0 \
	--disable-dev-shm-usage --disable-gpu \
	--autoplay-policy=no-user-gesture-required \
	--noerrdialogs --hide-scrollbars --disable-infobars \
	--disable-features=Translate,TranslateUI \
	--check-for-update-interval=31536000 \
	${STREAM_CHROME_ARGS:-} \
	"$URL" >/dev/null 2>&1 &
CPID=$!

cleanup() { kill "$XPID" "$CPID" "${FPID:-}" 2>/dev/null; wait 2>/dev/null; rm -rf "$PROFILE"; }
trap cleanup EXIT INT TERM

# Let the page paint before we start pulling frames.
sleep 8

# Encoder + delivery, tuned for a smooth multi-target live stream (validated
# on basho0). Key choices, all of which fought visible choppiness:
#   - CBR, no B-frames, keyframe every ~2 s: what YouTube/Twitch want, low latency.
#   - -fps_mode cfr + a big thread_queue: kills x11grab's dup/drop jitter.
#   - tee -use_fifo 1 + onfail=ignore (per slot): each target gets its own FIFO,
#     so one platform buffering can't stutter the others.
#   - queue_size=1024 (~8 s at 60 fps): the fifo default is 60 packets (~0.5 s),
#     and YouTube's ingest throttles the TCP window every so often — with the
#     tiny default every such pause overflowed the fifo and dropped packets on
#     that leg only ("FIFO queue full"), seen as YouTube-only framerate stutter
#     while the same bytes played smooth on Twitch (basho0, 2026-08-31).
#   - default ~3.5 Mbps: two targets = ~7 Mbps up, kind to a home uplink; text
#     streams clean at that. STREAM_BITRATE overrides.
# anullsrc adds the silent audio track both platforms require.
GOP=$((FPS * 2))
NG=${#BR_GROUPS[@]}
FIFO_OPTS="queue_size=1024:attempt_recovery=1:drop_pkts_on_overflow=1:recovery_wait_time=2:max_recovery_attempts=0"
USE_VAAPI=0
[ "${STREAM_VAAPI:-0}" = 1 ] && [ -e /dev/dri/renderD128 ] && USE_VAAPI=1

venc_for() { # $1 = bitrate → prints encoder args (space-separated, no spaces inside args)
	if [ "$USE_VAAPI" = 1 ]; then
		printf '%s' "-c:v h264_vaapi -rc_mode CBR -b:v $1 -maxrate $1 -bufsize $1 -g $GOP -keyint_min $GOP -bf 0"
	else
		printf '%s' "-c:v libx264 -preset veryfast -pix_fmt yuv420p -bf 0 -b:v $1 -maxrate $1 -bufsize $1 -g $GOP -keyint_min $GOP"
	fi
}

CMD=(ffmpeg -hide_banner -loglevel warning -stats -nostdin)
[ "$USE_VAAPI" = 1 ] && CMD+=(-vaapi_device /dev/dri/renderD128)
CMD+=(-thread_queue_size 1024 -f x11grab -draw_mouse 0 -framerate "$FPS" -video_size "$RES" -i ":$DPY"
	-f lavfi -i anullsrc=channel_layout=stereo:sample_rate=44100)

if [ "$NG" -eq 1 ]; then
	# one bitrate: the original single-encode tee, unchanged in shape
	[ "$USE_VAAPI" = 1 ] && CMD+=(-vf format=nv12,hwupload)
	# shellcheck disable=SC2046,SC2086
	CMD+=(-map 0:v -map 1:a -fps_mode cfr $(venc_for "${BR_GROUPS[0]}")
		-c:a aac -b:a 128k -ar 44100 ${STREAM_ARGS:-}
		-f tee -use_fifo 1 -fifo_options "$FIFO_OPTS" "$(dests_for "${BR_GROUPS[0]}")")
else
	# split the captured frames once, encode each bitrate group on its own
	# branch, and give every group its own tee (so per-leg fifo isolation is
	# kept). STREAM_ARGS is single-encode-only and skipped here on purpose.
	FC="[0:v]split=$NG"
	g=0; while [ "$g" -lt "$NG" ]; do FC="$FC[s$g]"; g=$((g + 1)); done
	g=0; while [ "$g" -lt "$NG" ]; do
		if [ "$USE_VAAPI" = 1 ]; then
			FC="$FC;[s$g]format=nv12,hwupload[v$g]"
		else
			FC="$FC;[s$g]null[v$g]"
		fi
		g=$((g + 1))
	done
	CMD+=(-filter_complex "$FC")
	g=0
	for br in "${BR_GROUPS[@]}"; do
		# shellcheck disable=SC2046
		CMD+=(-map "[v$g]" -map 1:a -fps_mode:v cfr $(venc_for "$br")
			-c:a aac -b:a 128k -ar 44100
			-f tee -use_fifo 1 -fifo_options "$FIFO_OPTS" "$(dests_for "$br")")
		g=$((g + 1))
	done
	echo "pipeos-stream-run: $NG encoder branches (${BR_GROUPS[*]})" >&2
fi

"${CMD[@]}" &
FPID=$!

# Respawn as a set: fall through the instant any child (renderer OR encoder)
# dies, so the trap cleans up and supervise-daemon restarts the whole pipeline.
wait -n
