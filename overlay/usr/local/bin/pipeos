#!/bin/sh
# pipeos — one front door for the persistence boundary on a pipeOS box.
#
# The root fs lives in RAM and is rebuilt at every boot from the boot media:
# apkovl (config/state) + local apk repos (software). Anything outside that
# boundary dies at reboot — that is the design. This tool makes crossing the
# boundary explicit and verified.
#
#   pipeos status              box health + persistence state at a glance
#   pipeos verify              will a reboot reproduce this state? (rc!=0: no)
#   pipeos diff [TS|known-good]  uncommitted changes / vs a snapshot
#   pipeos pkg add PKG...      install software persistently (verified)
#   pipeos pkg del PKG...      remove software persistently
#   pipeos snapshot ls         apkovl generations on the media
#   pipeos save                commit state now (guarded, atomic)
#   pipeos rollback [TS|known-good]  stage an older apkovl for next boot
#   pipeos sync-media          push freshly built pipeos repo -> media
#   pipeos backup DEST [--identity-only]   identity bundle + /work onto a mounted external
#   pipeos flash check|fetch|apply [--to DEV]   a new released image: in place, or onto a spare disk
#   pipeos restore-work SRC [--force] [--onto DEV]   /work back from a backup dir or an old stick's p2
#   pipeos deploy-overlay      install a repo commit's overlay onto this box
#   pipeos unclaim [--yes]     nobody's box again: drop the claim, name, users; reboot
#   pipeos wake NAME|ID|--all|--list|--forget ID   magic packet to a Machine this box has seen
#   pipeos cluster init [NAME]|status|ca|add|remove|sync|page|reboot-all|services KEY on|off [ID...]|call ID|NAME|IP METHOD PATH [JSON]   the cluster: identity (its CA), member list, the page, the two cluster-wide acts (#222, #211, #212)
#   pipeos vault status|list|set|get|del|export|unlock|rephrase   the sealed secret store
#   pipeos schedule ls|add|set|rm|enable|disable|run|log   the Machine's scheduled jobs (what the dashboard's Schedule view edits)
#   pipeos usage [totals|cap N|cap none]   the ledger's totals; the monthly cap (card, saved, enforced now)
#   pipeos card set KEY=VALUE...   a card field, regenerated and saved (what the dashboard's forms write)
#   pipeos secrets phrase [--ack]  the vault's pending recovery phrase; --ack forgets the tmpfs copy
#   pipeos assistant password      the assistant terminal's password from stdin -> vault, restarted, saved
#   pipeos nas account NAME      share-only account + its SMB password (stdin) — Files → Network storage's form
#   pipeos selfupdate image on|off|status   automatic image updates (default on): a newer release is applied and the box reboots
#   pipeos work status|flush|park|unpark   /work's hot set in RAM; park = flush + read-only (the stick idles)
#
# Read-only verbs (status/verify/diff/snapshot) are open to the resident
# agent; mutating verbs are root/human territory (pipebox-settings.json).

MEDIA=/media/usb
REPO_DIR=$MEDIA/apks/pipeos/x86_64
OVL=$MEDIA/pipeos.apkovl.tar.gz
KNOWN_GOOD=$MEDIA/pipeos.known-good.tar.gz
OVERLAY=/work/repos/pipeOS/overlay
REPO=${PIPEOS_REPO:-/work/repos/pipeOS}
STAMP=/etc/pipeos/.overlay-stamp
# operator-verb seams (the probe): the card, its generator, the saver, the ledger, the phrase file
CARD=${PIPEOS_CARD:-/etc/pipeos/card.conf}
CARD_GEN=${PIPEOS_CARD_GEN:-/usr/local/bin/pipebox-card}
SAVE_BIN=${PIPEOS_SAVE_BIN:-/usr/local/bin/pipeos-save}
LEDGER_PY=${PIPEOS_LEDGER:-/usr/local/share/pipeos/web/ledger.py}
VAULT_PHRASE=${PIPEOS_VAULT_PHRASE:-/run/pipeos/vault-phrase}
BASE_REF=${PIPEOS_BASE_REF:-origin/main}

ok()   { printf 'ok    %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; FAILED=1; }

sha() { sha256sum "$1" | cut -d' ' -f1; }

take_save_lock() {
    # shared with pipeos-save: one media mutator at a time
    exec 9> /run/pipeos-save.lock
    _i=0
    until flock -n 9; do
        _i=$((_i+1))
        [ "$_i" -ge 60 ] && { echo "save lock busy for 60s; giving up" >&2; exit 1; }
        sleep 1
    done
}

# ---------------------------------------------------------------- status
# How far behind $BASE_REF is the deployed commit? Prints a human phrase when
# the box is behind, and NOTHING when it is current or the question cannot be
# answered here (no checkout, unknown commit, no local origin/main). Silence
# means "no finding" — an unanswerable question must not read as up to date,
# so callers say so themselves rather than getting an empty string that looks
# reassuring. Never fetches: status runs at boot, before the network is up.
overlay_behind() {
    _c=$1
    [ -n "$_c" ] || return 0
    [ -d "$REPO/.git" ] || { echo "local checkout missing, cannot age it"; return 0; }
    git -C "$REPO" rev-parse --verify -q "$_c^{commit}" >/dev/null 2>&1 || {
        echo "deployed commit $(echo "$_c" | cut -c1-12) is not in the local checkout"; return 0; }
    _tip=$(git -C "$REPO" rev-parse --verify -q "$BASE_REF^{commit}" 2>/dev/null) || {
        echo "no $BASE_REF locally, cannot age it"; return 0; }
    [ "$_tip" = "$_c" ] && return 0
    # Is the deployed commit even ON $BASE_REF? box1 found this on review by
    # running the function in a throwaway repo: a box deployed from an
    # UNMERGED feature commit cut off the tip of main reports "current",
    # because `rev-list --count c..tip` is 0 whenever tip is an ancestor of c.
    # Once main moves it starts saying "1 commit behind" and STILL never says
    # the thing that matters — that what this box is running never landed.
    # This PR is what makes deploying from a branch easy, so it is also what
    # makes that state common. Reported before the count, because it is the
    # graver finding and the count is not wrong so much as beside the point.
    if ! git -C "$REPO" merge-base --is-ancestor "$_c" "$_tip" 2>/dev/null; then
        echo "deployed commit $(echo "$_c" | cut -c1-12) is NOT on $BASE_REF — this box is running an overlay that was never merged"
        return 0
    fi
    _n=$(git -C "$REPO" rev-list --count "$_c..$_tip" 2>/dev/null || echo 0)
    [ "${_n:-0}" -gt 0 ] || return 0
    # Age from the OLDEST undeployed commit: it is how long the fleet has been
    # missing a fix, which is the number #97 was filed over (four days).
    _old=$(git -C "$REPO" log --format=%ct "$_c..$_tip" 2>/dev/null | tail -1)
    _days=""
    [ -n "$_old" ] && _days=$(( ($(date +%s) - _old) / 86400 ))
    echo "$_n commit(s) behind $BASE_REF${_days:+, oldest undeployed is ${_days}d old}"
}

drift_count() {
    [ -d "$OVERLAY" ] || { echo 0; return; }
    n=0
    for d in usr/local/bin etc/init.d etc/local.d etc/periodic etc/pipeos; do
        [ -d "$OVERLAY/$d" ] || continue
        # pipebox.conf is per-box (owner nick, gh owner) — expected drift
        c=$(diff -rq "$OVERLAY/$d" "/$d" 2>/dev/null | \
            grep -e '^Files .* differ' -e "^Only in $OVERLAY" | \
            grep -cv 'pipebox\.conf')
        n=$((n + c))
    done
    echo "$n"
}

cmd_status() {
    printf '%s — up %s\n' "$(hostname)" "$(uptime | sed 's/.*up *//;s/,.*//' 2>/dev/null || uptime)"
    # The boot report, deliverable or not (appliance plan, decision 4): the
    # owner DM is gated on auth + OWNER_NICK, which a fresh box has neither
    # of, so selfcheck also lands every boot report in per-boot tmpfs.
    # "How did the boot go" must never depend on pipe being signed in.
    if [ -r /run/pipeos/boot-report ]; then
        bverdict=$(sed -n 's/^verdict: //p' /run/pipeos/boot-report | head -1)
        case "$bverdict" in
            *DEGRADED*) fail "boot report: $bverdict — cat /run/pipeos/boot-report" ;;
            *warning*)  warn "boot report: $bverdict — cat /run/pipeos/boot-report" ;;
            '')         warn "boot report present but verdict unreadable — cat /run/pipeos/boot-report" ;;
            *)          ok "boot report: $bverdict" ;;
        esac
    else
        warn "no boot report this boot (selfcheck --boot has not finished)"
    fi
    if [ ! -f /etc/pipeos/provisioned ]; then
        fail "UNPROVISIONED — autosave is OFF; nothing persists (claim the box at http://$(hostname).local/ or run pipebox-setup)"
    fi
    # Claim state: the web wizard's first credential. Unclaimed is the honest
    # out-of-box state, not an error — but say where to go.
    if [ -s /etc/pipeos/web-admin.conf ]; then
        ok "claimed (web admin set)"
    else
        warn "UNCLAIMED — first visitor to http://$(hostname).local/ owns this box"
    fi
    if mountpoint -q /work; then
        use=$(df /work | awk 'NR==2{print $5+0}')
        if [ "$use" -ge 90 ]; then warn "/work ${use}% full"; else ok "/work mounted, ${use}% used"; fi
    else
        fail "/work not mounted"
    fi
    # images built since #179 carry their own descriptor; older ones say nothing
    if [ -r "$MEDIA/pipeos-image.txt" ]; then
        _ib=$(sed -n 's/^built=//p' "$MEDIA/pipeos-image.txt" | head -1)
        _ic=$(sed -n 's/^commit=//p' "$MEDIA/pipeos-image.txt" | head -1 | cut -c1-12)
        ok "image built ${_ib:-?} @ ${_ic:-?}"
    fi
    free=$(df -k $MEDIA | awk 'NR==2{printf "%d", $4/1024}')
    if [ "${free:-0}" -lt 300 ]; then warn "media ${free}MB free"; else ok "media ${free}MB free"; fi
    # Which daemons SHOULD run is declared in services.conf (the web wizard
    # writes it); a box without the file predates the wizard — fleet legacy,
    # pipe assumed on. pipe off is a configuration, not a failure.
    SERVICE_PIPE=on SERVICE_CLAUDE=on SERVICE_STREAM=off SERVICE_SUPPORT=off
    # shellcheck disable=SC1091
    [ -r /etc/pipeos/services.conf ] && . /etc/pipeos/services.conf 2>/dev/null
    svcs="pipeos-web pipeos-mdns"
    [ "$SERVICE_PIPE" = on ] && svcs="$svcs pipe-daemon"
    [ "$SERVICE_PIPE" = on ] && [ "$SERVICE_CLAUDE" = on ] && svcs="$svcs pipebox-listener"
    [ "$SERVICE_STREAM" = on ] && svcs="$svcs pipeos-stream"
    [ "${SERVICE_SUPPORT:-off}" = on ] && svcs="$svcs pipeos-support"
    for svc in $svcs; do
        if rc-service "$svc" status >/dev/null 2>&1; then ok "$svc running"; else fail "$svc not running"; fi
    done
    # A running daemon with a revoked token is not healthy: it silently
    # destroys every inbound sealed message (pipe#641) and cannot send the
    # boot report (pipeOS#13/#19). Liveness above says nothing about this —
    # assert auth in both directions, not only on failure. See pipeOS#19.
    if [ "$SERVICE_PIPE" != on ]; then
        ok "pipe disabled (services.conf) — auth not applicable"
    elif authj=$(pipe status -o json 2>/dev/null); then
        if [ "$(echo "$authj" | jq -r '.status.authenticated // empty' 2>/dev/null)" = "true" ]; then
            ok "auth ok"
        else
            aerr=$(echo "$authj" | jq -r '.status.auth_error // empty' 2>/dev/null)
            fail "auth FAILED${aerr:+ — $aerr}"
        fi
    else
        fail "auth unknown — pipe status did not answer"
    fi
    if [ -f "$OVL" ]; then
        age=$(( ($(date +%s) - $(date -r "$OVL" +%s)) / 60 ))
        ok "apkovl saved ${age}min ago"
    else
        fail "canonical apkovl MISSING from media"
    fi
    dirty=$(lbu status 2>/dev/null | wc -l)
    if [ "$dirty" -gt 0 ]; then
        warn "$dirty uncommitted change(s) — see pipeos diff, persist with pipeos save"
    else
        ok "state committed"
    fi
    if [ -f "$KNOWN_GOOD" ]; then
        if [ "$(sha "$KNOWN_GOOD")" = "$(sha "$OVL")" ]; then
            ok "known-good == current apkovl"
        else
            warn "known-good differs from current apkovl (no healthy boot on this state yet)"
        fi
    else
        warn "no known-good apkovl yet (first healthy boot promotes one)"
    fi
    # What overlay is this box actually RUNNING, and how far behind is it?
    # The file-drift count below answers neither: it compares against whatever
    # branch the local checkout happens to be on, which on a box mid-review is
    # a feature branch. The stamp written by `pipeos deploy-overlay` is the
    # box's own record of what it deployed, so age is measured against main
    # rather than against a working tree. (pipeOS#97 item 2.)
    if [ -r "$STAMP" ]; then
        dc=$(sed -n 's/^commit //p' "$STAMP" | head -1)
        dat=$(sed -n 's/^deployed_at //p' "$STAMP" | head -1)
        behind=$(overlay_behind "$dc")
        if [ -n "$behind" ]; then
            warn "overlay at $(echo "$dc" | cut -c1-12) — $behind (pipeos deploy-overlay)"
        else
            ok "overlay at $(echo "$dc" | cut -c1-12), deployed $dat"
        fi
    else
        warn "no overlay deploy record ($STAMP) — this box's overlay was hand-copied; age unknown"
    fi
    drift=$(drift_count)
    if [ "$drift" -gt 0 ]; then
        warn "overlay drift: $drift file(s) differ from the local checkout's overlay (info; backport or deploy)"
    else
        ok "local checkout's overlay matches live system"
    fi
    [ -f /etc/pipeos/rollback-pending ] && warn "ROLLBACK STAGED — reboot to apply; saves are fenced"
    [ -f /run/pipeos/flash-pending ] && warn "NEW IMAGE APPLIED — reboot to boot it; saves are fenced until then"
    return 0
}

# ---------------------------------------------------------------- verify
cmd_verify() {
    FAILED=0
    tmpd=$(mktemp -d)

    # (a) pipeos repo coherence: the boot-time installer trusts this index;
    # a mismatch = silent package loss at next boot (the 2026-08-05 incident)
    if [ -f "$REPO_DIR/APKINDEX.tar.gz" ]; then
        tar -xzOf "$REPO_DIR/APKINDEX.tar.gz" APKINDEX 2>/dev/null | \
            awk -v RS='' '{p="";v="";n=split($0,L,"\n");
                for(i=1;i<=n;i++){if(L[i]~/^P:/)p=substr(L[i],3);if(L[i]~/^V:/)v=substr(L[i],3)}
                if(p!=""&&v!="")print p"-"v".apk"}' | sort > "$tmpd/indexed"
        ls "$REPO_DIR" | grep '\.apk$' | sort > "$tmpd/present"
        missing=$(comm -23 "$tmpd/indexed" "$tmpd/present" | tr '\n' ' ')
        orphans=$(comm -13 "$tmpd/indexed" "$tmpd/present" | tr '\n' ' ')
        [ -n "$missing" ] && fail "pipeos repo: indexed but missing on media: $missing"
        [ -n "$orphans" ] && warn "pipeos repo: on media but not in index (dead weight): $orphans"
        [ -z "$missing" ] && ok "pipeos repo: index matches $(wc -l < "$tmpd/present") apk(s)"
    else
        fail "pipeos repo index missing: $REPO_DIR/APKINDEX.tar.gz"
    fi

    # (b) boot-path resolution: same resolver + same local-only repos that
    # boot-time apk uses (extra repo is covered by this too)
    out=$(apk fix --simulate 2>&1); rc=$?
    if [ $rc -ne 0 ] || echo "$out" | grep -qi '^ERROR'; then
        fail "world does not resolve: $(echo "$out" | grep -i error | head -3 | tr '\n' '; ')"
    else
        ok "world resolves against media repos (apk fix --simulate)"
    fi

    # (c) every world entry is installed right now
    miss=""
    while read -r e; do
        [ -n "$e" ] || continue
        p=${e%%[<>=~]*}
        apk info -qe "$p" >/dev/null 2>&1 || miss="$miss $p"
    done < /etc/apk/world
    if [ -n "$miss" ]; then fail "in world but NOT installed:$miss"; else ok "all world packages installed"; fi

    # (d) content-hash pins strand the box on any rebuild (see repo CLAUDE.md)
    pins=$(grep -c '><Q1' /etc/apk/world 2>/dev/null)
    [ "${pins:-0}" -gt 0 ] && warn "$pins content-hash pin(s) in /etc/apk/world — break on any package rebuild"

    # (e) the apkovl the next boot will load
    if [ -f "$OVL" ] && tar -tzf "$OVL" >/dev/null 2>&1; then
        ok "canonical apkovl readable ($(wc -c < "$OVL") bytes)"
    else
        fail "canonical apkovl missing or unreadable"
    fi

    # (f) no secret in the clear once the vault exists (#244). A plaintext
    # copy beside the vault is the leak the vault closes; one INSIDE the
    # canonical apkovl means the next boot puts it back. A claimed box with
    # no vault yet is the deploy window before pipeos-vault's first run.
    if [ -f /etc/pipeos/vault.sealed ]; then
        _left=$(/usr/local/bin/pipeos-vault plaintext-left 2>/dev/null)
        if [ "$_left" != none ] && [ -n "$_left" ]; then
            fail "secrets still in the clear beside the vault: $(echo "$_left" | tr '\n' ' ')"
        elif [ -f "$OVL" ] && tar -tzf "$OVL" 2>/dev/null | grep -qE '^etc/pipeos/(claude-auth\.env|support_key|nas-private/)'; then
            fail "the canonical apkovl still carries a plaintext secret — pipeos save"
        else
            ok "secrets sealed: nothing in the clear, on disk or in the apkovl"
        fi
    elif [ -s /etc/pipeos/web-admin.conf ]; then
        warn "claimed, but no vault yet — pipeos-vault seals the secrets at the next boot (or: rc-service pipeos-vault start)"
    fi

    rm -rf "$tmpd"
    if [ "$FAILED" = 0 ]; then
        echo "verify: PASS — a reboot reproduces this state"
        return 0
    fi
    echo "verify: FAIL — a reboot will NOT reproduce this state"
    return 1
}

# ---------------------------------------------------------------- diff
snapshot_path() {
    case "$1" in
        known-good) echo "$KNOWN_GOOD" ;;
        baseline)   echo "$MEDIA/pipeos-baseline.tar.gz" ;;
        *)          echo "$MEDIA/pipeos.$1.tar.gz" ;;
    esac
}

cmd_diff() {
    if [ -z "$1" ]; then
        if [ -n "$(lbu status 2>/dev/null)" ]; then
            lbu status -v 2>/dev/null || lbu status
        else
            echo "no uncommitted changes (live state == canonical apkovl)"
        fi
        return 0
    fi
    src=$(snapshot_path "$1")
    [ -f "$src" ] || { echo "no such snapshot: $src (try: pipeos snapshot ls)" >&2; return 1; }
    tmpd=$(mktemp -d)
    tar -tzvf "$src" 2>/dev/null | awk '{print $3, $NF}' | sort -k2 > "$tmpd/a"
    tar -tzvf "$OVL" 2>/dev/null | awk '{print $3, $NF}' | sort -k2 > "$tmpd/b"
    echo "--- $(basename "$src")   +++ current apkovl   (size path)"
    diff "$tmpd/a" "$tmpd/b" | grep '^[<>]' || echo "identical file lists and sizes"
    rm -rf "$tmpd"
}

# ---------------------------------------------------------------- pkg
cmd_pkg() {
    op=$1; shift
    [ $# -ge 1 ] || { echo "usage: pipeos pkg add|del PKG..." >&2; return 1; }
    case "$op" in
        add) extra-add "$@" || return 1 ;;
        del) apk del "$@"  || return 1 ;;
        *)   echo "usage: pipeos pkg add|del PKG..." >&2; return 1 ;;
    esac
    echo "== verifying the boot path =="
    if ! cmd_verify; then
        echo "pkg $op: verification FAILED — state NOT saved." >&2
        echo "Fix the repo (or undo the change); saving now would persist a broken boot." >&2
        return 1
    fi
    /usr/local/bin/pipeos-save && echo "pkg $op: verified and saved — survives reboot."
}

# ---------------------------------------------------------------- snapshot
cmd_snapshot_ls() {
    printf '%-36s %10s  %-16s %s\n' NAME BYTES "SAVED (UTC)" SHA256/12
    for f in "$OVL" "$KNOWN_GOOD" "$MEDIA"/pipeos.[0-9]*.tar.gz "$MEDIA"/pipeos-baseline.tar.gz; do
        [ -f "$f" ] || continue
        printf '%-36s %10s  %-16s %s\n' "$(basename "$f")" "$(wc -c < "$f")" \
            "$(date -u -r "$f" '+%Y-%m-%d %H:%M')" "$(sha "$f" | cut -c1-12)"
    done
}

# ---------------------------------------------------------------- rollback
cmd_rollback() {
    if [ -f /run/pipeos/flash-pending ] && [ -n "$1" ]; then
        echo "rollback: a new image is applied and not yet booted — reboot first (a rollback now would stage the pre-apply apkovl on the new image; pipeOS#276)" >&2
        return 1
    fi
    if [ -z "$1" ]; then
        echo "stage an older apkovl as what the next boot loads:"
        [ -f "$KNOWN_GOOD" ] && echo "  pipeos rollback known-good"
        ls "$MEDIA"/pipeos.[0-9]*.tar.gz 2>/dev/null | \
            sed 's|.*pipeos\.\([0-9]*\)\.tar\.gz|  pipeos rollback \1|'
        return 0
    fi
    case "$1" in
        /*) src=$1 ;;   # an identity bundle (pipeos backup / pipeos flash) by path
        *)  src=$(snapshot_path "$1") ;;
    esac
    [ -f "$src" ] || { echo "no such snapshot: $src" >&2; return 1; }
    tar -tzf "$src" >/dev/null 2>&1 || { echo "snapshot unreadable — refusing" >&2; return 1; }

    take_save_lock
    mount -o remount,rw "$MEDIA" || { echo "cannot remount media rw" >&2; return 1; }
    cp "$src" "$OVL.new" && sync && mv "$OVL.new" "$OVL" && sync
    rc=$?
    rm -f "$OVL.new"
    sync; mount -o remount,ro "$MEDIA" 2>/dev/null
    [ $rc -eq 0 ] || { echo "rollback write failed" >&2; return 1; }
    touch /etc/pipeos/rollback-pending
    echo "staged $(basename "$src") as next-boot state — reboot to apply."
    echo "(saves are fenced until then; the fence lives in tmpfs and clears itself at reboot)"
}

# ------------------------------------------------------------- unclaim
# The reclaim path (docs/cluster.md §1, §11): the web claim, the dashboard
# users, the owner's name and owner nick go; the box reboots into the wizard
# as an unclaimed Machine at pipeos-<id>.local. Kept on purpose, because they
# are the operator's and not the claim's: root's ssh keys, the Claude
# sign-in, the pipe identity (NICK) on a fleet-role box, /work. A GENERIC
# box's NICK is cleared too — it was derived from a sign-in that belonged to
# the previous owner.
cmd_unclaim() {
    [ "$(id -u)" = 0 ] || { echo "unclaim: root only" >&2; return 1; }
    [ -f /etc/pipeos/rollback-pending ] && { echo "unclaim: a rollback is staged — reboot first" >&2; return 1; }
    [ -f /run/pipeos/flash-pending ] && { echo "unclaim: a new image is applied and not yet booted — reboot first (pipeOS#276)" >&2; return 1; }
    _hn=$(hostname)
    if [ "$1" != "--yes" ]; then
        echo "This makes $_hn nobody's box: claim, dashboard users, name and owner are"
        echo "removed and it reboots into the setup wizard. Type the hostname to continue:"
        read -r _ans
        [ "$_ans" = "$_hn" ] || { echo "did not match $_hn — nothing changed" >&2; return 1; }
    fi
    _card=/etc/pipeos/card.conf
    sed -i 's/^NAME=.*/NAME=/; s/^OWNER_NICK=.*/OWNER_NICK=/' "$_card"
    if [ "$(sed -n 's/^ROLE=//p' "$_card" | head -1)" = GENERIC ]; then
        sed -i 's/^NICK=.*/NICK=/' "$_card"
    fi
    pipebox-card generate --card "$_card" >/dev/null || { echo "card regeneration failed" >&2; return 1; }
    rm -f /etc/pipeos/web-admin.conf /etc/pipeos/users.json /etc/pipeos/terminals.conf \
          /etc/pipeos/services.conf
    # nobody's box has nobody's secrets: the vault and its export go too (#244)
    rm -f /etc/pipeos/vault.sealed /etc/pipeos/support_key.pub
    rm -rf /run/pipeos/web-sessions /run/pipeos/secrets
    # save BEFORE the provisioned marker goes: pipeos-save is a no-op without
    # it, and the removal itself is what has to reach the media
    /usr/local/bin/pipeos-save || { echo "save failed — the box is still claimed on the media" >&2; return 1; }
    rm -f /etc/pipeos/provisioned
    # the marker's removal is the one change that cannot go through
    # pipeos-save; lbu is the canonical writer underneath it
    lbu commit -d >/dev/null 2>&1 || { echo "final commit failed" >&2; return 1; }
    echo "$_hn is unclaimed; rebooting into the wizard at http://$_hn.local/"
    sleep 2; reboot
}

# ---------------------------------------------------------------- operator verbs (#259)
# The dashboard's forms, as verbs: the same file, the same validation, the
# same save. An operator over ssh — or the owner's agent on a workstation —
# drives a Machine with these instead of hand-editing /etc (which the fence
# and the deploy rules both forbid, for the reason CLAUDE.md gives: a hand
# edit is a change nobody can find later).
cmd_card_set() {
    [ $# -ge 1 ] || { echo "usage: pipeos card set KEY=VALUE..." >&2; exit 2; }
    [ -f "$CARD" ] || { echo "no card at $CARD" >&2; exit 1; }
    for kv in "$@"; do
        k=${kv%%=*}; v=${kv#*=}
        case "$k" in
            ''|*[!A-Z0-9_]*) echo "card set: KEY is [A-Z0-9_]: '$k'" >&2; exit 2 ;;
        esac
        [ "$kv" != "$k" ] || { echo "card set: $k needs =VALUE (empty is allowed: $k=)" >&2; exit 2; }
        case "$v" in *"
"*|*'|'*) echo "card set: a value is one line, no |" >&2; exit 2 ;; esac
        # a box claimed before the key existed has no KEY= line: add the generator's empty default
        grep -q "^$k=" "$CARD" || printf '%s=\n' "$k" >> "$CARD"
        sed -i "s|^$k=.*|$k=$v|" "$CARD"
        echo "card: $k=$v"
    done
    "$CARD_GEN" generate --card "$CARD" >/dev/null || { echo "card set: regeneration FAILED — the card is edited but the derived files are stale; fix the value (pipebox-card generate says what)" >&2; exit 1; }
    "$SAVE_BIN" >/dev/null && echo "saved" || { echo "saved: NO — run pipeos save" >&2; exit 1; }
}

cmd_usage() {
    case "${1:-totals}" in
        totals) [ $# -gt 0 ] && shift; exec python3 "$LEDGER_PY" totals "$@" ;;
        cap)
            v=${2:-}
            case "$v" in
                none|0) cmd_card_set "MONTHLY_CAP_USD=" ;;
                ''|*[!0-9]*) echo "usage: pipeos usage cap N|none   (whole dollars, 1-100000)" >&2; exit 2 ;;
                *) [ "$v" -ge 1 ] && [ "$v" -le 100000 ] || { echo "the cap is 1-100000 dollars (or none)" >&2; exit 2; }
                   cmd_card_set "MONTHLY_CAP_USD=$v" ;;
            esac
            # enforce now: lowering under this month's spend pauses jobs at once, raising lifts it
            python3 "$LEDGER_PY" enforce ;;
        *) echo "usage: pipeos usage [totals [--json]|cap N|cap none]" >&2; exit 2 ;;
    esac
}

cmd_secrets() {
    case "${1:-}" in
        phrase)
            if [ -s "$VAULT_PHRASE" ]; then
                cat "$VAULT_PHRASE"
                if [ "${2:-}" = --ack ]; then rm -f "$VAULT_PHRASE"; echo "acked — the tmpfs copy is gone; keep the phrase somewhere that is not this box"; fi
            else
                echo "no recovery phrase pending (already acked, or the vault was never migrated here)"; exit 1
            fi ;;
        *) echo "usage: pipeos secrets phrase [--ack]" >&2; exit 2 ;;
    esac
}

cmd_assistant() {
    case "${1:-}" in
        password)
            [ ! -t 0 ] || { echo "usage: printf '%s' PASSWORD | pipeos assistant password" >&2; exit 2; }
            /usr/local/bin/pipeos-vault set assistant_pass assistant >/dev/null || exit 1
            # `set` writes the sealed store; the service reads the /run export, which
            # only the vault's boot start writes — export now or the restart sees the old one
            /usr/local/bin/pipeos-vault export >/dev/null || exit 1
            echo "assistant password: set in the vault, exported to /run/pipeos/secrets"
            rc-service pipeos-assistant restart >/dev/null 2>&1 9>&- && echo "pipeos-assistant restarted" || echo "pipeos-assistant did not start — rc-service pipeos-assistant status" >&2
            "$SAVE_BIN" >/dev/null && echo "saved" || { echo "saved: NO — run pipeos save" >&2; exit 1; } ;;
        *) echo "usage: pipeos assistant password   (the password on stdin)" >&2; exit 2 ;;
    esac
}

# ---------------------------------------------------------------- main
case "$1" in
    status)      cmd_status ;;
    verify)      cmd_verify ;;
    diff)        shift; cmd_diff "$@" ;;
    pkg)         shift; cmd_pkg "$@" ;;
    snapshot)    [ "$2" = ls ] || { echo "usage: pipeos snapshot ls" >&2; exit 1; }; cmd_snapshot_ls ;;
    save)        exec /usr/local/bin/pipeos-save ;;
    rollback)    shift; cmd_rollback "$@" ;;
    sync-media)  shift; exec /usr/local/bin/pipeos-sync-media "$@" ;;
    backup)      shift; exec /usr/local/bin/pipeos-backup "$@" ;;
    flash)       shift; exec /usr/local/bin/pipeos-flash "$@" ;;
    restore-work) shift; exec /usr/local/bin/pipeos-restore-work "$@" ;;
    deploy-overlay) shift; exec /usr/local/bin/pipeos-deploy-overlay "$@" ;;
    selfupdate)  shift; exec /usr/local/bin/pipeos-selfupdate "$@" ;;
    unclaim)     shift; cmd_unclaim "$@" ;;
    wake)        shift; exec /usr/local/bin/pipeos-wake "$@" ;;
    cluster)     shift; exec python3 /usr/local/share/pipeos/web/cluster.py "$@" ;;
    vault)       shift; exec /usr/local/bin/pipeos-vault "$@" ;;
    schedule)    shift; exec python3 /usr/local/share/pipeos/web/schedctl.py "$@" ;;
    usage)       shift; cmd_usage "$@" ;;
    card)        [ "${2:-}" = set ] || { echo "usage: pipeos card set KEY=VALUE..." >&2; exit 2; }; shift 2; cmd_card_set "$@" ;;
    secrets)     shift; cmd_secrets "$@" ;;
    assistant)   shift; cmd_assistant "$@" ;;
    nas)         shift; exec python3 /usr/local/share/pipeos/web/nasctl.py "$@" ;;
    work)        shift; exec /usr/local/bin/pipeos-work "$@" ;;
    *)
        sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
