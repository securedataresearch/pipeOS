#!/bin/bash
# pipeos-assistant-run — launch the ttyd browser terminal for pipeos-assistant.
#
# Serves an xterm.js terminal that attaches to a shared tmux session running
# `claude --continue` in the dashboard-chat working dir, so the browser terminal
# and the dashboard's chat are the same assistant (same conversation, same
# /root/.claude memory). Run under supervise-daemon (see the init script).
#
# NOTE: ttyd takes the password on its argv, so it is visible in `ps` to a root
# user on the box — acceptable on a single-owner appliance (root already owns
# the box), and the password never leaves the box. Config is /etc/pipeos/
# assistant.conf (mode 600); the OAuth token comes from claude-auth.env.
set -u

CONF=/etc/pipeos/assistant.conf
AUTH=/etc/pipeos/claude-auth.env
SETTINGS=/etc/pipeos/pipebox-settings.json
WORKDIR=/work/pipebox/webchat

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
# shellcheck disable=SC1090
# one line, one of two variables: a setup-token (the owner's subscription)
# or an Anthropic Console key. A browser sign-in leaves no file — claude
# finds its own credential under HOME. Export only what is set: an empty
# exported ANTHROPIC_API_KEY is a credential claude would try to use.
if [ -r "$AUTH" ]; then
    . "$AUTH"
    [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && export CLAUDE_CODE_OAUTH_TOKEN
    [ -n "${ANTHROPIC_API_KEY:-}" ] && export ANTHROPIC_API_KEY
fi

export HOME=/root
mkdir -p "$WORKDIR" 2>/dev/null
cd "$WORKDIR" 2>/dev/null || cd /root || exit 1

TTYD_USER=${ASSISTANT_USER:-admin}
PORT=${ASSISTANT_PORT:-7681}
BACKEND=${ASSISTANT_BACKEND:-claude}
if [ -z "${ASSISTANT_PASS:-}" ]; then
	echo "pipeos-assistant-run: ASSISTANT_PASS is empty — refusing to serve an open terminal" >&2
	exit 1
fi

# The box can ship more than one assistant; ASSISTANT_BACKEND picks which one
# the master session runs (the dashboard writes it; pipeos-assistant-claude
# reads it).
case "$BACKEND" in hermes) BIN=hermes ;; *) BIN=claude ;; esac
command -v "$BIN" >/dev/null 2>&1 || {
	echo "pipeos-assistant-run: backend '$BACKEND' is not installed" >&2
	exit 1
}

# One master claude per Machine (docs/cluster.md; Sam, 2026-09-10): the
# session lives in a tmux server on a socket of its own, started DETACHED
# here — not by ttyd on the first browser connect — so it exists whether or
# not a browser is open, survives ttyd respawns, and a user terminal can
# `claude` into it (pipeos-claude-attach). The command inside is
# pipeos-assistant-claude, which adds --continue only when there is a
# conversation to continue: on a fresh box `claude --continue` exits with
# "No conversation found to continue" and the session died the instant it
# started, every connect respawning it into the same failure.
SOCK=/run/pipeos/assistant/tmux.sock
mkdir -p /run/pipeos/assistant
chown root:users /run/pipeos/assistant; chmod 750 /run/pipeos/assistant
if ! tmux -S "$SOCK" has-session -t assistant 2>/dev/null; then
	tmux -S "$SOCK" new-session -d -s assistant -x 200 -y 50 \
		"ASSISTANT_BACKEND=$BACKEND exec /usr/local/bin/pipeos-assistant-claude" || {
		echo "pipeos-assistant-run: could not start the master session" >&2; exit 1; }
fi
# the socket is root's; terminal users reach it through the group and an
# explicit tmux grant per user (tmux >= 3.3 server-access), never by default
chgrp users "$SOCK" 2>/dev/null; chmod 660 "$SOCK" 2>/dev/null
if [ -r /etc/pipeos/terminals.conf ]; then
	# shellcheck disable=SC1091
	. /etc/pipeos/terminals.conf
	i=1
	while [ "$i" -le 16 ]; do
		eval "u=\${TERM_${i}_USER:-}"
		[ -n "$u" ] && tmux -S "$SOCK" server-access -a "$u" 2>/dev/null
		i=$((i + 1))
	done
fi

# --writable so the client can type; every browser attaches to the one
# master session.
exec ttyd --writable --interface 0.0.0.0 --port "$PORT" \
	--credential "${TTYD_USER}:${ASSISTANT_PASS}" \
	-t "titleFixed=$(hostname 2>/dev/null || echo pipeos) assistant" \
	-t 'theme={"background":"#131417"}' \
	tmux -S "$SOCK" attach-session -t assistant
